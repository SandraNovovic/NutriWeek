@page
@model LoginModel

@{
    ViewData["Title"] = "Log in";
}

<div class="identity-page">
    <div class="identity-container">

        <div class="identity-side">
            <div class="identity-side-content">
                <span class="identity-brand">NutriWeek</span>

                <h1>
                    Plan better.<br />
                    Eat better.
                </h1>

                <p>
                    Keep your weekly meals organized and make
                    healthy eating easier every day.
                </p>
            </div>
        </div>

        <div class="identity-form-side">
            <div class="identity-form-wrapper">

                <div class="identity-form-header">
                    <span class="identity-mobile-brand">
                        NutriWeek
                    </span>

                    <h2>Welcome back</h2>

                    <p>
                        Log in to continue planning your week.
                    </p>
                </div>

                <form id="account"
                      method="post"
                      asp-route-returnUrl="@Model.ReturnUrl">

                    <div asp-validation-summary="ModelOnly"
                         class="identity-validation"
                         role="alert">
                    </div>

                    <div class="identity-field">
                        <label asp-for="Input.Email">
                            Email
                        </label>

                        <input asp-for="Input.Email"
                               class="form-control identity-input"
                               autocomplete="username"
                               aria-required="true"
                               placeholder="name@example.com" />

                        <span asp-validation-for="Input.Email"
                              class="text-danger">
                        </span>
                    </div>

                    <div class="identity-field">
                        <label asp-for="Input.Password">
                            Password
                        </label>

                        <input asp-for="Input.Password"
                               class="form-control identity-input"
                               autocomplete="current-password"
                               aria-required="true"
                               placeholder="Enter your password" />

                        <span asp-validation-for="Input.Password"
                              class="text-danger">
                        </span>
                    </div>

                    <div class="identity-options">
                        <label class="identity-checkbox">
                            <input asp-for="Input.RememberMe"
                                   class="form-check-input" />

                            <span>Remember me</span>
                        </label>

                        <a asp-page="./ForgotPassword"
                           class="identity-small-link">
                            Forgot password?
                        </a>
                    </div>

                    <button id="login-submit"
                            type="submit"
                            class="identity-submit">
                        Log in
                    </button>

                    <div class="identity-bottom-text">
                        Don't have an account?

                        <a asp-page="./Register"
                           asp-route-returnUrl="@Model.ReturnUrl">
                            Create account
                        </a>
                    </div>

                </form>
            </div>
        </div>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}