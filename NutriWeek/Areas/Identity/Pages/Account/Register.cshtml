@page
@model RegisterModel

@{
    ViewData["Title"] = "Register";
}

<div class="identity-page">
    <div class="identity-container">

        <div class="identity-side">
            <div class="identity-side-content">
                <span class="identity-brand">NutriWeek</span>

                <h1>
                    Your healthy week<br />
                    starts here.
                </h1>

                <p>
                    Create your account and build a meal plan
                    that works for you.
                </p>
            </div>
        </div>

        <div class="identity-form-side">
            <div class="identity-form-wrapper">

                <div class="identity-form-header">
                    <span class="identity-mobile-brand">
                        NutriWeek
                    </span>

                    <h2>Create account</h2>

                    <p>
                        Start planning your meals with NutriWeek.
                    </p>
                </div>

                <form id="registerForm"
                      asp-route-returnUrl="@Model.ReturnUrl"
                      method="post">

                    <div asp-validation-summary="ModelOnly"
                         class="identity-validation"
                         role="alert">
                    </div>

                    <div class="identity-field">
                        <label asp-for="Input.Email">
                            Email
                        </label>

                        <input asp-for="Input.Email"
                               class="form-control identity-input"
                               autocomplete="username"
                               aria-required="true"
                               placeholder="name@example.com" />

                        <span asp-validation-for="Input.Email"
                              class="text-danger">
                        </span>
                    </div>

                    <div class="identity-field">
                        <label asp-for="Input.Password">
                            Password
                        </label>

                        <input asp-for="Input.Password"
                               class="form-control identity-input"
                               autocomplete="new-password"
                               aria-required="true"
                               placeholder="Create a password" />

                        <span asp-validation-for="Input.Password"
                              class="text-danger">
                        </span>
                    </div>

                    <div class="identity-field">
                        <label asp-for="Input.ConfirmPassword">
                            Confirm password
                        </label>

                        <input asp-for="Input.ConfirmPassword"
                               class="form-control identity-input"
                               autocomplete="new-password"
                               aria-required="true"
                               placeholder="Repeat your password" />

                        <span asp-validation-for="Input.ConfirmPassword"
                              class="text-danger">
                        </span>
                    </div>

                    <button id="registerSubmit"
                            type="submit"
                            class="identity-submit">
                        Create account
                    </button>

                    <div class="identity-bottom-text">
                        Already have an account?

                        <a asp-page="./Login"
                           asp-route-returnUrl="@Model.ReturnUrl">
                            Log in
                        </a>
                    </div>

                </form>
            </div>
        </div>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}