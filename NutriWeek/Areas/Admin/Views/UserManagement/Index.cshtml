@using NutriWeek.Areas.Admin.ViewModels
@using static NutriWeek.GCommon.ApplicationConstants

@model IEnumerable<UserViewModel>

@{
    ViewData["Title"] = "User Management";
}

<style>

    .users-page {
        padding: 44px 0 70px;
    }

    .users-header {
        margin-bottom: 24px;
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 18px;
    }

    .users-eyebrow {
        margin-bottom: 7px;
        color: #4a8a50;
        font-size: 12px;
        font-weight: 800;
        letter-spacing: .08em;
        text-transform: uppercase;
    }

    .users-title {
        margin: 0;
        color: #193224;
        font-size: 40px;
        font-weight: 900;
    }

    .users-subtitle {
        margin: 8px 0 0;
        color: #78837b;
        font-size: 13px;
    }

    .back-admin-button {
        padding: 10px 14px;
        border: 1px solid #d5e2d2;
        border-radius: 11px;
        background: white;
        color: #3b7742;
        text-decoration: none;
        font-size: 12px;
        font-weight: 800;
    }

    .admin-message {
        margin-bottom: 16px;
        padding: 13px 16px;
        border-radius: 12px;
        font-size: 12px;
        font-weight: 800;
    }

    .admin-message.success {
        border: 1px solid #cae4c6;
        background: #edf8eb;
        color: #37733f;
    }

    .admin-message.error {
        border: 1px solid #efcccc;
        background: #fff1f1;
        color: #a34747;
    }

    .users-card {
        overflow: hidden;
        border: 1px solid #dfe8dc;
        border-radius: 18px;
        background: white;
        box-shadow: 0 10px 28px rgba(38, 67, 43, .06);
    }

    .users-table {
        width: 100%;
        border-collapse: collapse;
    }

    .users-table th,
    .users-table td {
        padding: 15px 18px;
        border-bottom: 1px solid #edf2eb;
        text-align: left;
        vertical-align: middle;
    }

    .users-table th {
        background: #f6faf4;
        color: #6f7b72;
        font-size: 11px;
        font-weight: 900;
        letter-spacing: .04em;
        text-transform: uppercase;
    }

    .users-table tr:last-child td {
        border-bottom: none;
    }

    .user-email {
        color: #24382b;
        font-size: 13px;
        font-weight: 800;
    }

    .role-list {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
    }

    .role-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 5px 8px 5px 9px;
        border-radius: 999px;
        background: #edf6e9;
        color: #3f7d46;
        font-size: 10px;
        font-weight: 900;
    }

    .remove-role-form {
        margin: 0;
        display: inline-flex;
    }

    .remove-role-button {
        width: 18px;
        height: 18px;
        padding: 0;
        display: grid;
        place-items: center;
        border: 0;
        border-radius: 50%;
        background: rgba(63, 125, 70, .12);
        color: #3f7d46;
        cursor: pointer;
        font-size: 12px;
        font-weight: 900;
        line-height: 1;
    }

    .remove-role-button:hover {
        background: #f8dede;
        color: #a74b4b;
    }

    .no-role {
        color: #9aa39c;
        font-size: 11px;
        font-style: italic;
    }

    .assign-role-form {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .role-select {
        min-width: 130px;
        padding: 8px 10px;
        border: 1px solid #d9e4d6;
        border-radius: 9px;
        background: white;
        color: #3c4e42;
        font-size: 11px;
        outline: none;
    }

    .role-select:focus {
        border-color: #77a975;
        box-shadow: 0 0 0 3px rgba(83, 145, 83, .10);
    }

    .assign-role-button {
        padding: 8px 11px;
        border: 0;
        border-radius: 9px;
        background: #408a47;
        color: white;
        cursor: pointer;
        font-size: 10px;
        font-weight: 900;
    }

    .assign-role-button:hover {
        background: #34763b;
    }

    .all-roles-assigned {
        color: #8e9991;
        font-size: 10px;
        font-style: italic;
    }

    .users-empty {
        padding: 45px 20px;
        color: #7d887f;
        text-align: center;
    }

    @@media (max-width: 850px) {

        .users-header {
            align-items: flex-start;
            flex-direction: column;
        }

        .users-title {
            font-size: 33px;
        }

        .users-card {
            overflow-x: auto;
        }

        .users-table {
            min-width: 760px;
        }
    }

</style>


<div class="users-page">

    <header class="users-header">

        <div>

            <div class="users-eyebrow">
                NutriWeek Administration
            </div>

            <h1 class="users-title">
                User Management
            </h1>

            <p class="users-subtitle">
                View users, assign roles and remove roles.
            </p>

        </div>


        <a asp-area="Admin"
           asp-controller="Home"
           asp-action="Index"
           class="back-admin-button">

            ← Back to Dashboard

        </a>

    </header>


    @if (TempData["Success"] != null)
    {
        <div class="admin-message success">
            @TempData["Success"]
        </div>
    }


    @if (TempData["Error"] != null)
    {
        <div class="admin-message error">
            @TempData["Error"]
        </div>
    }


    <section class="users-card">

        @if (Model.Any())
        {
            <table class="users-table">

                <thead>

                    <tr>
                        <th>Email</th>
                        <th>Current Roles</th>
                        <th>Assign Role</th>
                    </tr>

                </thead>


                <tbody>

                    @foreach (UserViewModel user
                              in Model)
                    {
                        List<string> rolesToAssign =
                            user.AvailableRoles
                                .Where(role =>
                                    !user.Roles.Contains(role))
                                .ToList();


                        <tr>

                            <td class="user-email">
                                @user.Email
                            </td>


                            <td>

                                @if (user.Roles.Any())
                                {
                                    <div class="role-list">

                                        @foreach (string role
                                                  in user.Roles)
                                        {
                                            <span class="role-badge">

                                                @role

                                                <form asp-area="Admin"
                                                      asp-controller="UserManagement"
                                                      asp-action="RemoveRole"
                                                      method="post"
                                                      class="remove-role-form">

                                                    <input type="hidden"
                                                           name="userId"
                                                           value="@user.Id" />

                                                    <input type="hidden"
                                                           name="roleName"
                                                           value="@role" />


                                                    <button type="submit"
                                                            class="remove-role-button"
                                                            title="Remove @role role">
                                                        ×
                                                    </button>

                                                </form>

                                            </span>
                                        }

                                    </div>
                                }
                                else
                                {
                                    <span class="no-role">
                                        No role assigned
                                    </span>
                                }

                            </td>


                            <td>

                                @if (rolesToAssign.Any())
                                {
                                    <form asp-area="Admin"
                                          asp-controller="UserManagement"
                                          asp-action="AddRole"
                                          method="post"
                                          class="assign-role-form">

                                        <input type="hidden"
                                               name="userId"
                                               value="@user.Id" />


                                        <select name="roleName"
                                                class="role-select"
                                                required>

                                            @foreach (string role
                                                      in rolesToAssign)
                                            {
                                                <option value="@role">
                                                    @role
                                                </option>
                                            }

                                        </select>


                                        <button type="submit"
                                                class="assign-role-button">
                                            Assign
                                        </button>

                                    </form>
                                }
                                else
                                {
                                    <span class="all-roles-assigned">
                                        All roles assigned
                                    </span>
                                }

                            </td>

                        </tr>
                    }

                </tbody>

            </table>
        }
        else
        {
            <div class="users-empty">
                No registered users found.
            </div>
        }

    </section>

</div>
