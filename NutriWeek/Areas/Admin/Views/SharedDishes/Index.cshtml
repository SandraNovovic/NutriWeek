@using NutriWeek.Areas.Admin.ViewModels

@model IEnumerable<SharedDishViewModel>

@{
    ViewData["Title"] = "Shared Dishes";
}

<style>

    .shared-dishes-page {
        padding: 44px 0 70px;
    }

    .shared-header {
        margin-bottom: 24px;
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 18px;
    }

    .shared-eyebrow {
        margin-bottom: 7px;
        color: #4a8a50;
        font-size: 12px;
        font-weight: 800;
        letter-spacing: .08em;
        text-transform: uppercase;
    }

    .shared-title {
        margin: 0;
        color: #193224;
        font-size: 40px;
        font-weight: 900;
    }

    .shared-subtitle {
        margin: 8px 0 0;
        color: #78837b;
        font-size: 13px;
    }

    .shared-header-actions {
        display: flex;
        align-items: center;
        gap: 10px;
        flex-wrap: wrap;
    }

    .add-shared-button,
    .back-admin-button {
        padding: 10px 14px;
        border: 1px solid #d5e2d2;
        border-radius: 11px;
        background: white;
        color: #3b7742;
        text-decoration: none;
        font-size: 12px;
        font-weight: 800;
    }

    .add-shared-button {
        border-color: #3f8947;
        background: #3f8947;
        color: white;
    }

    .add-shared-button:hover {
        background: #34753b;
        color: white;
    }

    .admin-message {
        margin-bottom: 16px;
        padding: 13px 16px;
        border-radius: 12px;
        font-size: 12px;
        font-weight: 800;
    }

    .admin-message.success {
        border: 1px solid #cae4c6;
        background: #edf8eb;
        color: #37733f;
    }

    .admin-message.error {
        border: 1px solid #efcccc;
        background: #fff1f1;
        color: #a34747;
    }

    .shared-card {
        overflow: hidden;
        border: 1px solid #dfe8dc;
        border-radius: 18px;
        background: white;
        box-shadow: 0 10px 28px rgba(38, 67, 43, .06);
    }

    .shared-table {
        width: 100%;
        border-collapse: collapse;
    }

    .shared-table th,
    .shared-table td {
        padding: 15px 18px;
        border-bottom: 1px solid #edf2eb;
        text-align: left;
        vertical-align: middle;
    }

    .shared-table th {
        background: #f6faf4;
        color: #6f7b72;
        font-size: 11px;
        font-weight: 900;
        letter-spacing: .04em;
        text-transform: uppercase;
    }

    .shared-table tr:last-child td {
        border-bottom: none;
    }

    .dish-name {
        color: #24382b;
        font-size: 13px;
        font-weight: 850;
    }

    .dish-meta {
        color: #738078;
        font-size: 12px;
        font-weight: 700;
    }

    .status-badge {
        display: inline-flex;
        padding: 6px 9px;
        border-radius: 999px;
        font-size: 10px;
        font-weight: 900;
    }

    .status-badge.active {
        background: #eaf6e8;
        color: #3d8245;
    }

    .status-badge.deleted {
        background: #fff0f0;
        color: #a54a4a;
    }

    .dish-action-form {
        margin: 0;
    }

    .dish-action-button {
        min-width: 78px;
        padding: 8px 11px;
        border: 0;
        border-radius: 9px;
        cursor: pointer;
        font-size: 10px;
        font-weight: 900;
    }

    .dish-action-button.delete {
        background: #fff0f0;
        color: #a54a4a;
        border: 1px solid #efcccc;
    }

    .dish-action-button.restore {
        background: #edf6e9;
        color: #397b41;
        border: 1px solid #cde2c9;
    }

    .shared-empty {
        padding: 50px 20px;
        color: #7d887f;
        text-align: center;
    }

    .delete-modal-backdrop {
        display: none;
        position: fixed;
        inset: 0;
        z-index: 3000;
        align-items: center;
        justify-content: center;
        padding: 20px;
        background: rgba(24, 39, 29, .48);
        backdrop-filter: blur(3px);
    }

    .delete-modal-backdrop.show {
        display: flex;
    }

    .delete-modal {
        width: min(430px, 100%);
        padding: 26px;
        border: 1px solid #ead8d4;
        border-radius: 22px;
        background: white;
        box-shadow: 0 24px 65px rgba(22, 38, 28, .24);
    }

    .delete-modal-icon {
        width: 54px;
        height: 54px;
        margin-bottom: 16px;
        display: grid;
        place-items: center;
        border-radius: 16px;
        background: #fff0ee;
        font-size: 24px;
    }

    .delete-modal-title {
        margin: 0;
        color: #2b392f;
        font-size: 22px;
        font-weight: 900;
    }

    .delete-modal-text {
        margin: 10px 0 0;
        color: #7a837d;
        font-size: 13px;
        line-height: 1.65;
    }

    .delete-modal-dish {
        margin-top: 15px;
        padding: 11px 13px;
        border: 1px solid #ece4e1;
        border-radius: 12px;
        background: #faf7f6;
        color: #774b43;
        font-size: 12px;
        font-weight: 850;
    }

    .delete-modal-actions {
        margin-top: 22px;
        display: flex;
        justify-content: flex-end;
        gap: 9px;
    }

    .delete-modal-button {
        min-width: 100px;
        padding: 10px 14px;
        border-radius: 11px;
        cursor: pointer;
        font-size: 11px;
        font-weight: 900;
    }

    .delete-modal-button.cancel {
        border: 1px solid #d7e1d5;
        background: white;
        color: #5f6f63;
    }

    .delete-modal-button.confirm {
        border: 1px solid #c95e52;
        background: #c95e52;
        color: white;
    }

    .delete-modal-button.confirm:hover {
        background: #b94f45;
    }

    @@media (max-width: 760px) {

        .shared-header {
            align-items: flex-start;
            flex-direction: column;
        }

        .shared-title {
            font-size: 33px;
        }

        .shared-card {
            overflow-x: auto;
        }

        .shared-table {
            min-width: 680px;
        }
    }

</style>


<div class="shared-dishes-page">

    <header class="shared-header">

        <div>

            <div class="shared-eyebrow">
                NutriWeek Administration
            </div>

            <h1 class="shared-title">
                Shared Dishes
            </h1>

            <p class="shared-subtitle">
                Manage the global dishes available to all NutriWeek users.
            </p>

        </div>


        <div class="shared-header-actions">

            <a asp-area="Admin"
               asp-controller="SharedDishes"
               asp-action="Add"
               class="add-shared-button">

                + Add Shared Dish

            </a>

            <a asp-area="Admin"
               asp-controller="Home"
               asp-action="Index"
               class="back-admin-button">

                ← Back to Dashboard

            </a>

        </div>

    </header>


    @if (TempData["Success"] != null)
    {
        <div class="admin-message success">
            @TempData["Success"]
        </div>
    }


    @if (TempData["Error"] != null)
    {
        <div class="admin-message error">
            @TempData["Error"]
        </div>
    }


    <section class="shared-card">

        @if (Model.Any())
        {
            <table class="shared-table">

                <thead>

                    <tr>
                        <th>Dish</th>
                        <th>Type</th>
                        <th>Calories</th>
                        <th>Preparation</th>
                        <th>Status</th>
                        <th>Action</th>
                    </tr>

                </thead>


                <tbody>

                    @foreach (SharedDishViewModel dish
                              in Model)
                    {
                        <tr>

                            <td class="dish-name">
                                @dish.Name
                            </td>

                            <td class="dish-meta">
                                @dish.DishType
                            </td>

                            <td class="dish-meta">
                                @dish.Calories kcal
                            </td>

                            <td class="dish-meta">
                                @dish.PreparationTime min
                            </td>

                            <td>

                                @if (dish.IsDeleted)
                                {
                                    <span class="status-badge deleted">
                                        Deleted
                                    </span>
                                }
                                else
                                {
                                    <span class="status-badge active">
                                        Active
                                    </span>
                                }

                            </td>

                            <td>

                                @if (dish.IsDeleted)
                                {
                                    <form asp-area="Admin"
                                          asp-controller="SharedDishes"
                                          asp-action="Restore"
                                          method="post"
                                          class="dish-action-form">

                                        <input type="hidden"
                                               name="id"
                                               value="@dish.Id" />

                                        <button type="submit"
                                                class="dish-action-button restore">
                                            Restore
                                        </button>

                                    </form>
                                }
                                else
                                {
                                    <button type="button"
                                            class="dish-action-button delete open-delete-modal"
                                            data-dish-id="@dish.Id"
                                            data-dish-name="@dish.Name">
                                        Delete
                                    </button>
                                }

                            </td>

                        </tr>
                    }

                </tbody>

            </table>
        }
        else
        {
            <div class="shared-empty">
                No shared dishes found.
            </div>
        }

    </section>


    <div id="deleteSharedDishModal"
         class="delete-modal-backdrop"
         role="dialog"
         aria-modal="true"
         aria-labelledby="deleteSharedDishTitle"
         hidden>

        <div class="delete-modal">

            <div class="delete-modal-icon">
                🗑️
            </div>

            <h2 id="deleteSharedDishTitle"
                class="delete-modal-title">
                Delete shared dish?
            </h2>

            <p class="delete-modal-text">
                This dish will no longer be available to users.
                You can restore it later from Shared Dishes.
            </p>

            <div id="deleteSharedDishName"
                 class="delete-modal-dish">
            </div>


            <form asp-area="Admin"
                  asp-controller="SharedDishes"
                  asp-action="Delete"
                  method="post"
                  class="delete-modal-actions">

                <input id="deleteSharedDishId"
                       type="hidden"
                       name="id" />

                <button id="cancelDeleteSharedDish"
                        type="button"
                        class="delete-modal-button cancel">
                    Cancel
                </button>

                <button type="submit"
                        class="delete-modal-button confirm">
                    Delete Dish
                </button>

            </form>

        </div>

    </div>

</div>


<script>

    document.addEventListener(
        "DOMContentLoaded",
        () => {

            const modal =
                document.getElementById(
                    "deleteSharedDishModal");

            const dishIdInput =
                document.getElementById(
                    "deleteSharedDishId");

            const dishNameElement =
                document.getElementById(
                    "deleteSharedDishName");

            const cancelButton =
                document.getElementById(
                    "cancelDeleteSharedDish");


            const openButtons =
                document.querySelectorAll(
                    ".open-delete-modal");


            const closeModal = () => {

                modal.classList.remove(
                    "show");

                modal.hidden =
                    true;

                dishIdInput.value =
                    "";

                dishNameElement.textContent =
                    "";
            };


            openButtons.forEach(
                button => {

                    button.addEventListener(
                        "click",
                        () => {

                            dishIdInput.value =
                                button.dataset.dishId;

                            dishNameElement.textContent =
                                button.dataset.dishName;


                            modal.hidden =
                                false;

                            modal.classList.add(
                                "show");
                        });
                });


            cancelButton.addEventListener(
                "click",
                closeModal);


            modal.addEventListener(
                "click",
                event => {

                    if (event.target === modal) {
                        closeModal();
                    }
                });


            document.addEventListener(
                "keydown",
                event => {

                    if (event.key === "Escape" &&
                        !modal.hidden) {

                        closeModal();
                    }
                });
        });

</script>
