@{
    ViewData["Title"] = "Admin Dashboard";
}

<style>

    .admin-page {
        padding: 48px 0 70px;
    }

    .admin-header {
        margin-bottom: 28px;
    }

    .admin-eyebrow {
        margin-bottom: 8px;
        color: #4a8a50;
        font-size: 12px;
        font-weight: 800;
        letter-spacing: .08em;
        text-transform: uppercase;
    }

    .admin-title {
        margin: 0;
        color: #193224;
        font-size: 42px;
        font-weight: 900;
    }

    .admin-subtitle {
        max-width: 650px;
        margin: 10px 0 0;
        color: #738077;
        line-height: 1.6;
    }

    .admin-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 18px;
    }

    .admin-card {
        padding: 24px;
        border: 1px solid #dfe8dc;
        border-radius: 18px;
        background: #ffffff;
        box-shadow: 0 10px 28px rgba(38, 67, 43, .06);
    }

    .admin-card-icon {
        width: 48px;
        height: 48px;
        margin-bottom: 14px;
        display: grid;
        place-items: center;
        border-radius: 14px;
        background: #edf6e9;
        font-size: 22px;
    }

    .admin-card h2 {
        margin: 0;
        color: #21382a;
        font-size: 20px;
        font-weight: 850;
    }

    .admin-card p {
        margin: 8px 0 0;
        color: #7b867f;
        font-size: 13px;
        line-height: 1.6;
    }

    @@media (max-width: 700px) {

        .admin-grid {
            grid-template-columns: 1fr;
        }

        .admin-title {
            font-size: 34px;
        }
    }

</style>


<div class="admin-page">

    <header class="admin-header">

        <div class="admin-eyebrow">
            NutriWeek Administration
        </div>

        <h1 class="admin-title">
            Admin Dashboard
        </h1>

        <p class="admin-subtitle">
            This area is available only to users with the
            Administrator role. User management will be added
            in the next step.
        </p>

    </header>


    <div class="admin-grid">

        <section class="admin-card">

            <div class="admin-card-icon">
                👥
            </div>

            <h2>
                User Management
            </h2>

            <p>
                View users and manage their roles.
                We will implement this in the next step.
            </p>

        </section>


        <section class="admin-card">

            <div class="admin-card-icon">
                🔐
            </div>

            <h2>
                Role Protected
            </h2>

            <p>
                This dashboard is protected with
                Administrator role authorization.
            </p>

        </section>

    </div>

</div>
