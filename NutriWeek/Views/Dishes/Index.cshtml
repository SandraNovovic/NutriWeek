@using NutriWeek.Data.Models
@model IEnumerable<Dish>

@{
    ViewData["Title"] = "Dishes";

    List<Dish> dishes = Model?.ToList() ?? new List<Dish>();

    Dictionary<string, string> dishImages =
        new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase)
        {
            { "Vegan Oatmeal", "~/images/DishesImages/vegan_oatmeal.png" },
            { "Vegetarian Pasta", "~/images/DishesImages/vegetarian_pasta.png" },
            { "Chicken Rice Bowl", "~/images/DishesImages/chicken_rice_bowl.png" },
            { "Salmon with Vegetables", "~/images/DishesImages/salmon_with_vegetables.png" },
            { "Lentil Soup", "~/images/DishesImages/lentil_soup.png" }
        };

    /*
        Temporary mapping because Breakfast / Lunch / Dinner
        belong logically to Meal rather than Dish.
    */
    Dictionary<string, string> mealTypes =
        new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase)
        {
            { "Vegan Oatmeal", "Breakfast" },
            { "Vegetarian Pasta", "Lunch" },
            { "Chicken Rice Bowl", "Lunch" },
            { "Salmon with Vegetables", "Dinner" },
            { "Lentil Soup", "Lunch" }
        };

    int breakfastCount =
        dishes.Count(dish =>
            mealTypes.ContainsKey(dish.Name) &&
            mealTypes[dish.Name] == "Breakfast");

    int lunchCount =
        dishes.Count(dish =>
            mealTypes.ContainsKey(dish.Name) &&
            mealTypes[dish.Name] == "Lunch");

    int dinnerCount =
        dishes.Count(dish =>
            mealTypes.ContainsKey(dish.Name) &&
            mealTypes[dish.Name] == "Dinner");

    int vegetarianCount =
        dishes.Count(dish =>
            dish.DishType.ToString()
                .Equals(
                    "Vegetarian",
                    StringComparison.OrdinalIgnoreCase));

    int veganCount =
        dishes.Count(dish =>
            dish.DishType.ToString()
                .Equals(
                    "Vegan",
                    StringComparison.OrdinalIgnoreCase));

    int meatCount =
        dishes.Count(dish =>
            dish.DishType.ToString()
                .Equals(
                    "Meat",
                    StringComparison.OrdinalIgnoreCase));

    int fishCount =
        dishes.Count(dish =>
            dish.DishType.ToString()
                .Equals(
                    "Fish",
                    StringComparison.OrdinalIgnoreCase));
}

