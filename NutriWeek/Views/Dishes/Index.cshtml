                    </div>

                    <div class="category-count">
                        @meatCount recipes
                    </div>

                </div>

            </div>



            <div class="category-card fish"
                 data-top-group="diet"
                 data-top-value="fish">

                <div class="category-icon-frame">

                    <img src="~/images/Icons/fish-icon.png"
                         class="fish-icon"
                         alt="Fish" />

                </div>


                <div class="category-info">

                    <div class="category-name">
                        Fish
                    </div>

                    <div class="category-count">
                        @fishCount recipes
                    </div>

                </div>

            </div>


        </section>



        <section class="dishes-content">


            <!-- =================================================
                 FILTER SIDEBAR
                 ================================================= -->

            <aside class="filter-sidebar">


                <div class="search-box">

                    🔍

                    <input id="dishSearch"
                           type="text"
                           placeholder="Search dishes..." />

                </div>



                <div class="filter-title">
                    Meal Type
                </div>


                <label class="filter-option">

                    <span class="filter-option-left">

                        <input type="checkbox"
                               class="meal-filter"
                               value="breakfast" />

                        Breakfast

                    </span>


                    <span class="filter-count">
                        @breakfastCount
                    </span>

                </label>



                <label class="filter-option">

                    <span class="filter-option-left">

                        <input type="checkbox"
                               class="meal-filter"
                               value="lunch" />

                        Lunch

                    </span>


                    <span class="filter-count">
                        @lunchCount
                    </span>

                </label>



                <label class="filter-option">

                    <span class="filter-option-left">

                        <input type="checkbox"
                               class="meal-filter"
                               value="dinner" />

                        Dinner

                    </span>


                    <span class="filter-count">
                        @dinnerCount
                    </span>

                </label>



                <div class="filter-title">
                    Diet Type
                </div>


                <label class="filter-option">

                    <span class="filter-option-left">

                        <input type="checkbox"
                               class="diet-filter"
                               value="vegetarian" />

                        Vegetarian

                    </span>


                    <span class="filter-count">
                        @vegetarianCount
                    </span>

                </label>



                <label class="filter-option">

                    <span class="filter-option-left">

                        <input type="checkbox"
                               class="diet-filter"
                               value="vegan" />

                        Vegan

                    </span>


                    <span class="filter-count">
                        @veganCount
                    </span>

                </label>



                <label class="filter-option">

                    <span class="filter-option-left">

                        <input type="checkbox"
                               class="diet-filter"
                               value="meat" />

                        Meat

                    </span>


                    <span class="filter-count">
                        @meatCount
                    </span>

                </label>



                <label class="filter-option">

                    <span class="filter-option-left">

                        <input type="checkbox"
                               class="diet-filter"
                               value="fish" />

                        Fish

                    </span>


                    <span class="filter-count">
                        @fishCount
                    </span>

                </label>



                <div class="filter-title">
                    Cooking Time
                </div>


                <label class="filter-option">

                    <span class="filter-option-left">

                        <input type="checkbox"
                               class="time-filter"
                               value="under15" />

                        Under 15 min

                    </span>

                </label>



                <label class="filter-option">

                    <span class="filter-option-left">

                        <input type="checkbox"
                               class="time-filter"
                               value="15to30" />

                        15 - 30 min

                    </span>

                </label>



                <label class="filter-option">

                    <span class="filter-option-left">

                        <input type="checkbox"
                               class="time-filter"
                               value="over30" />

                        Over 30 min

                    </span>

                </label>



                <div class="filter-title">
                    Calories
                </div>


                <select id="calorieFilter"
                        class="calories-select">

                    <option value="all">
                        Any
                    </option>

                    <option value="under350">
                        Under 350 kcal
                    </option>

                    <option value="350to450">
                        350 - 450 kcal
                    </option>

                    <option value="451to550">
                        451 - 550 kcal
                    </option>

                    <option value="over550">
                        Over 550 kcal
                    </option>

                </select>



                <button id="clearFilters"
                        class="clear-filter"
                        type="button">

                    ↻ Clear Filters

                </button>


            </aside>



            <!-- =================================================
                 DISHES
                 ================================================= -->

            <main class="dishes-main">


                <div class="dishes-toolbar">


                    <h2>

                        <span id="visibleDishCount">
                            @dishes.Count
                        </span>

                        Dishes

                    </h2>



                    <div class="toolbar-right">

                        <span class="sort-label">
                            Sort by
                        </span>


                        <select id="sortDishes"
                                class="sort-select">

                            <option value="default">
                                Newest
                            </option>

                            <option value="nameAsc">
                                Name A-Z
                            </option>

                            <option value="caloriesAsc">
                                Calories: Low to High
                            </option>

                            <option value="caloriesDesc">
                                Calories: High to Low
                            </option>

                        </select>


                        <a asp-controller="Dishes"
                           asp-action="AddDish""
                           class="add-dish-btn">

                            ＋ Add Dish

                        </a>

                    </div>


                </div>



                <div id="dishGrid"
                     class="dish-grid">


                    @foreach (Dish dish in dishes)
                    {

                        string imagePath =
                        dishImages.ContainsKey(dish.Name)
                        ? dishImages[dish.Name]
                        : "~/images/DishesImages/hero_chicken_bowl.png";


                        string dietType =
                        dish.DishType
                        .ToString()
                        .ToLowerInvariant();


                        string mealType =
                        mealTypes.ContainsKey(dish.Name)
                        ? mealTypes[dish.Name]
                        .ToLowerInvariant()
                        : "";


                        string mealDisplay =
                        string.IsNullOrEmpty(mealType)
                        ? ""
                        : char.ToUpper(mealType[0]) +
                        mealType.Substring(1);


                        string mealTagClass =
                        mealType switch
                        {
                            "breakfast"
                                            => "meal-tag-breakfast",

                            "lunch"
                                            => "meal-tag-lunch",

                            "dinner"
                                            => "meal-tag-dinner",

                            _
                                            => ""
                        };


                        <article class="dish-card"
                                 data-name="@dish.Name.ToLowerInvariant()"
                                 data-diet="@dietType"
                                 data-meal="@mealType"
                                 data-time="@dish.PreparationTime"
                                 data-calories="@dish.Calories">


                            <div class="dish-image-wrapper">

                                <img src="@Url.Content(imagePath)"
                                     alt="@dish.Name" />


                                <div class="heart">
                                    ♥
                                </div>

                            </div>



                            <div class="dish-body">


                                <div class="dish-name">
                                    @dish.Name
                                </div>



                                <div class="dish-tags">


                                    @if (!string.IsNullOrEmpty(mealDisplay))
                                    {

                                        <span class="dish-tag @mealTagClass">

                                            @mealDisplay

                                        </span>

                                    }


                                    <span class="dish-tag">

                                        @dish.DishType

                                    </span>


                                </div>



                                <div class="dish-description">

                                    @dish.Description

                                </div>



                                <div class="dish-meta">


                                    <span>
                                        🔥 @dish.Calories kcal
                                    </span>


                                    <span>
                                        ⏱ @dish.PreparationTime min
                                    </span>


                                    <span>
                                        👥 @dish.Portions servings
                                    </span>


                                </div>



                                <div class="dish-actions">


                                    <a asp-controller="Dishes"
                                       asp-action="Details"
                                       asp-route-id="@dish.Id"
                                       class="dish-action">

                                        Details

                                    </a>


                                    <a asp-controller="Dishes"
                                       asp-action="Edit"
                                       asp-route-id="@dish.Id"
                                       class="dish-action">

                                        Edit

                                    </a>


                                    <a asp-controller="Dishes"
                                       asp-action="Delete"
                                       asp-route-id="@dish.Id"
                                       class="dish-action">

                                        Delete

                                    </a>


                                </div>


                            </div>


                        </article>

                    }



                    <div id="noResults"
                         class="no-results">

                        <h4>
                            No dishes found
                        </h4>

                        <p>
                            Try changing or clearing your filters.
                        </p>

                    </div>


                </div>


            </main>


        </section>


    </div>

</div>



<script>

    document.addEventListener(
        "DOMContentLoaded",
        function () {


            const searchInput =
                document.getElementById(
                    "dishSearch"
                );


            const navbarSearchInput =
                document.getElementById(
                    "navbarDishSearch"
                );


            const mealFilters =
                document.querySelectorAll(
                    ".meal-filter"
                );


            const dietFilters =
                document.querySelectorAll(
                    ".diet-filter"
                );


            const timeFilters =
                document.querySelectorAll(
                    ".time-filter"
                );


            const calorieFilter =
                document.getElementById(
                    "calorieFilter"
                );


            const clearButton =
                document.getElementById(
                    "clearFilters"
                );


            const topFilters =
                document.querySelectorAll(
                    ".category-card"
                );


            const dishGrid =
                document.getElementById(
                    "dishGrid"
                );


            const dishCards =
                Array.from(
                    document.querySelectorAll(
                        ".dish-card"
                    )
                );


            const countElement =
                document.getElementById(
                    "visibleDishCount"
                );


            const noResults =
                document.getElementById(
                    "noResults"
                );


            const sortSelect =
                document.getElementById(
                    "sortDishes"
                );



            function getCheckedValues(
                selector
            ) {

                return Array
                    .from(
                        document.querySelectorAll(
                            selector + ":checked"
                        )
                    )
                    .map(
                        checkbox =>
                            checkbox.value
                    );

            }



            function matchesCookingTime(
                minutes,
                selectedTimes
            ) {

                if (
                    selectedTimes.length === 0
                ) {

                    return true;

                }


                return selectedTimes.some(
                    filter => {


                        if (
                            filter === "under15"
                        ) {

                            return minutes < 15;

                        }


                        if (
                            filter === "15to30"
                        ) {

                            return (
                                minutes >= 15 &&
                                minutes <= 30
                            );

                        }


                        if (
                            filter === "over30"
                        ) {

                            return minutes > 30;

                        }


                        return true;

                    }
                );

            }



            function matchesCalories(
                calories,
                filter
            ) {

                if (
                    filter === "all"
                ) {

                    return true;

                }


                if (
                    filter === "under350"
                ) {

                    return calories < 350;

                }


                if (
                    filter === "350to450"
                ) {

                    return (
                        calories >= 350 &&
                        calories <= 450
                    );

                }


                if (
                    filter === "451to550"
                ) {

                    return (
                        calories >= 451 &&
                        calories <= 550
                    );

                }


                if (
                    filter === "over550"
                ) {

                    return calories > 550;

                }


                return true;

            }



            function applyFilters() {


                const searchText =
                    searchInput
                        .value
                        .trim()
                        .toLowerCase();


                const selectedMeals =
                    getCheckedValues(
                        ".meal-filter"
                    );


                const selectedDiets =
                    getCheckedValues(
                        ".diet-filter"
                    );


                const selectedTimes =
                    getCheckedValues(
                        ".time-filter"
                    );


                const selectedCalories =
                    calorieFilter.value;


                let visibleCount = 0;



                dishCards.forEach(
                    card => {


                        const name =
                            card.dataset.name;


                        const meal =
                            card.dataset.meal;


                        const diet =
                            card.dataset.diet;


                        const preparationTime =
                            Number(
                                card.dataset.time
                            );


                        const calories =
                            Number(
                                card.dataset.calories
                            );


                        const searchMatches =
                            name.includes(
                                searchText
                            );


                        const mealMatches =
                            selectedMeals.length === 0 ||
                            selectedMeals.includes(
                                meal
                            );


                        const dietMatches =
                            selectedDiets.length === 0 ||
                            selectedDiets.includes(
                                diet
                            );


                        const timeMatches =
                            matchesCookingTime(
                                preparationTime,
                                selectedTimes
                            );


                        const calorieMatches =
                            matchesCalories(
                                calories,
                                selectedCalories
                            );


                        const shouldShow =
                            searchMatches &&
                            mealMatches &&
                            dietMatches &&
                            timeMatches &&
                            calorieMatches;


                        card.classList.toggle(
                            "filtered-out",
                            !shouldShow
                        );


                        if (shouldShow) {

                            visibleCount++;

                        }


                    }
                );


                countElement.textContent =
                    visibleCount;


                noResults.classList.toggle(
                    "show",
                    visibleCount === 0
                );

            }



            function clearTopSelection() {


                topFilters.forEach(
                    card => {

                        card.classList.remove(
                            "selected"
                        );

                    }
                );

            }



            function selectAllTopCard() {


                clearTopSelection();


                const allCard =
                    document.querySelector(
                        '[data-top-group="all"]'
                    );


                if (allCard) {

                    allCard.classList.add(
                        "selected"
                    );

                }

            }



            function clearAllCheckboxes() {


                document
                    .querySelectorAll(
                        ".meal-filter, " +
                        ".diet-filter, " +
                        ".time-filter"
                    )
                    .forEach(
                        checkbox => {

                            checkbox.checked =
                                false;

                        }
                    );

            }



            function syncSearch(
                source,
                target
            ) {

                target.value =
                    source.value;

            }



            topFilters.forEach(
                card => {


                    card.addEventListener(
                        "click",
                        function () {


                            const group =
                                this.dataset.topGroup;


                            const value =
                                this.dataset.topValue;


                            clearAllCheckboxes();


                            calorieFilter.value =
                                "all";


                            searchInput.value =
                                "";


                            navbarSearchInput.value =
                                "";


                            clearTopSelection();


                            this.classList.add(
                                "selected"
                            );


                            if (
                                group === "meal"
                            ) {

                                const checkbox =
                                    document.querySelector(
                                        '.meal-filter[value="' +
                                        value +
                                        '"]'
                                    );


                                if (checkbox) {

                                    checkbox.checked =
                                        true;

                                }

                            }


                            if (
                                group === "diet"
                            ) {

                                const checkbox =
                                    document.querySelector(
                                        '.diet-filter[value="' +
                                        value +
                                        '"]'
                                    );


                                if (checkbox) {

                                    checkbox.checked =
                                        true;

                                }

                            }


                            applyFilters();


                        }
                    );

                }
            );



            searchInput.addEventListener(
                "input",
                function () {


                    syncSearch(
                        searchInput,
                        navbarSearchInput
                    );


                    clearTopSelection();


                    applyFilters();


                }
            );



            navbarSearchInput.addEventListener(
                "input",
                function () {


                    syncSearch(
                        navbarSearchInput,
                        searchInput
                    );


                    clearTopSelection();


                    applyFilters();


                }
            );



            mealFilters.forEach(
                checkbox => {


                    checkbox.addEventListener(
                        "change",
                        function () {


                            clearTopSelection();


                            applyFilters();


                        }
                    );

                }
            );



            dietFilters.forEach(
                checkbox => {


                    checkbox.addEventListener(
                        "change",
                        function () {


                            clearTopSelection();


                            applyFilters();


                        }
                    );

                }
            );



            timeFilters.forEach(
                checkbox => {


                    checkbox.addEventListener(
                        "change",
                        function () {


                            clearTopSelection();


                            applyFilters();


                        }
                    );

                }
            );



            calorieFilter.addEventListener(
                "change",
                function () {


                    clearTopSelection();


                    applyFilters();


                }
            );



            clearButton.addEventListener(
                "click",
                function () {


                    searchInput.value =
                        "";


                    navbarSearchInput.value =
                        "";


                    clearAllCheckboxes();


                    calorieFilter.value =
                        "all";


                    sortSelect.value =
                        "default";


                    selectAllTopCard();


                    dishCards.forEach(
                        card => {


                            dishGrid.insertBefore(
                                card,
                                noResults
                            );


                        }
                    );


                    applyFilters();


                }
            );



            sortSelect.addEventListener(
                "change",
                function () {


                    const cards =
                        [...dishCards];


                    if (
                        this.value ===
                        "nameAsc"
                    ) {

                        cards.sort(
                            (a, b) =>

                                a.dataset.name
                                    .localeCompare(
                                        b.dataset.name
                                    )

                        );

                    }


                    if (
                        this.value ===
                        "caloriesAsc"
                    ) {

                        cards.sort(
                            (a, b) =>

                                Number(
                                    a.dataset.calories
                                )
                                -
                                Number(
                                    b.dataset.calories
                                )

                        );

                    }


                    if (
                        this.value ===
                        "caloriesDesc"
                    ) {

                        cards.sort(
                            (a, b) =>

                                Number(
                                    b.dataset.calories
                                )
                                -
                                Number(
                                    a.dataset.calories
                                )

                        );

                    }


                    cards.forEach(
                        card => {


                            dishGrid.insertBefore(
                                card,
                                noResults
                            );


                        }
                    );


                }
            );



            applyFilters();


        }
    );

</script>