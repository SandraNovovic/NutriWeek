@using NutriWeek.Data.Models.Enums
@using NutriWeek.Web.ViewModels.Dishes

@model DishesIndexViewModel

@{
    ViewData["Title"] = "Dishes";

    List<DishIndexViewModel> dishes =
        Model.Dishes;

    Dictionary<string, string> dishImages =
        new Dictionary<string, string>(
            StringComparer.OrdinalIgnoreCase)
        {
            { "Vegan Oatmeal", "/images/DishesImages/vegan_oatmeal.png" },
            { "Vegetarian Pasta", "/images/DishesImages/vegetarian_pasta.png" },
            { "Chicken Rice Bowl", "/images/DishesImages/chicken_rice_bowl.png" },
            { "Salmon with Vegetables", "/images/DishesImages/salmon_with_vegetables.png" },
            { "Lentil Soup", "/images/DishesImages/lentil_soup.png" }
        };
}

<style>

    /* =====================================================
                       REMOVE DEFAULT MVC LAYOUT
                       ===================================================== */

    body > header,
    body > footer {
        display: none;
    }

    body {
        margin: 0;
        padding: 0;
        background: #f8faf5;
    }

        body > .container {
            width: 100% !important;
            max-width: none !important;
            margin: 0 !important;
            padding: 0 !important;
        }

            body > .container > main {
                margin: 0 !important;
                padding: 0 !important;
            }


    /* =====================================================
                       NAVBAR
                       ===================================================== */




    /* =====================================================
                       PAGE
                       ===================================================== */

    .dishes-page {
        position: relative;
        left: 50%;
        width: 100vw;
        min-height: 100vh;
        margin-left: -50vw;
        padding: 25px 0 70px;
        background-image: linear-gradient( rgba(250,252,247,.90), rgba(250,252,247,.90) ), url('@Url.Content("~/images/DishesImages/background.png")');
        background-size: cover;
        background-position: center;
        background-attachment: fixed;
    }

    .dishes-container {
        width: min(1420px, calc(100% - 50px));
        margin: 0 auto;
    }


    /* =====================================================
                       HERO
                       ===================================================== */

    .dishes-hero {
        height: 300px;
        margin-bottom: 18px;
        display: flex;
        align-items: center;
        overflow: hidden;
        border-radius: 26px;
        background-image: linear-gradient( 90deg, rgba(239,247,233,.98) 0%, rgba(239,247,233,.94) 38%, rgba(239,247,233,.25) 61%, rgba(239,247,233,0) 100% ), url('@Url.Content("~/images/DishesImages/hero_chicken_bowl.png")');
        background-size: cover;
        background-position: center;
        box-shadow: 0 5px 18px rgba(36,69,39,.06);
    }

    .hero-content {
        width: 53%;
        padding-left: 55px;
    }

    .hero-kicker {
        margin-bottom: 12px;
        color: #305836;
        font-size: 13px;
        font-weight: 700;
        letter-spacing: 3px;
    }

    .hero-title {
        margin-bottom: 15px;
        color: #111b14;
        font-size: 58px;
        font-weight: 800;
        line-height: 1;
    }

        .hero-title span {
            color: #2f7b35;
        }

    .hero-text {
        max-width: 600px;
        margin: 0;
        color: #344036;
        font-size: 18px;
        line-height: 1.45;
    }


    /* =====================================================
                       CATEGORY CARDS
                       ===================================================== */

    .categories-row {
        margin-bottom: 24px;
        display: grid;
        grid-template-columns: repeat(5, minmax(0,1fr));
        gap: 12px;
    }

    .category-card {
        min-width: 0;
        height: 84px;
        padding: 11px;
        display: flex;
        align-items: center;
        gap: 10px;
        border: 1px solid transparent;
        border-radius: 16px;
        background: rgba(255,255,255,.90);
        cursor: pointer;
        transition: transform .2s ease, box-shadow .2s ease, border-color .2s ease;
    }

        .category-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 7px 18px rgba(0,0,0,.06);
        }

        .category-card.selected {
            border-color: #2f7b35;
            box-shadow: 0 0 0 1px rgba(47,123,53,.08);
        }

        .category-card.vegetarian {
            background: #eef7eb;
        }

        .category-card.vegan {
            background: #edf8ee;
        }

        .category-card.meat {
            background: #fceff0;
        }

        .category-card.fish {
            background: #edf6fd;
        }


    /* =====================================================
                       ICONS
                       ===================================================== */

    .category-icon-frame {
        width: 54px;
        height: 54px;
        min-width: 54px;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
        border-radius: 50%;
        background: rgba(255,255,255,.72);
    }

        .category-icon-frame img {
            width: 54px;
            height: 54px;
            display: block;
            object-fit: cover;
            transform: scale(1.15);
        }

            .category-icon-frame img.fish-icon {
                width: 48px;
                height: 48px;
                object-fit: contain;
                transform: scale(1.05);
            }

    .all-category-icon {
        font-size: 26px;
    }

    .category-info {
        min-width: 0;
    }

    .category-name {
        margin-bottom: 2px;
        font-size: 13px;
        font-weight: 700;
        white-space: nowrap;
    }

    .category-count {
        color: #79817a;
        font-size: 10px;
        white-space: nowrap;
    }


    /* =====================================================
                       MAIN CONTENT
                       ===================================================== */

    .dishes-content {
        display: grid;
        grid-template-columns: 250px minmax(0,1fr);
        gap: 22px;
    }

    .dishes-main {
        min-width: 0;
    }


    /* =====================================================
                       FILTER SIDEBAR
                       ===================================================== */

    .filter-sidebar {
        height: fit-content;
        padding: 18px;
        border: 1px solid #e5eae2;
        border-radius: 20px;
        background: rgba(255,255,255,.94);
        box-shadow: 0 4px 14px rgba(0,0,0,.035);
    }

    .search-box {
        width: 100%;
        margin-bottom: 22px;
        padding: 10px 13px;
        display: flex;
        align-items: center;
        gap: 8px;
        border: 1px solid #dfe5dc;
        border-radius: 25px;
        background: #fff;
    }

        .search-box input {
            width: 100%;
            border: none;
            outline: none;
            background: transparent;
            font-size: 13px;
        }

    .filter-title {
        margin: 18px 0 10px;
        color: #253027;
        font-size: 14px;
        font-weight: 800;
    }

    .filter-option {
        margin-bottom: 8px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        color: #555f57;
        font-size: 13px;
        cursor: pointer;
    }

    .filter-option-left {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .filter-option input {
        width: 15px;
        height: 15px;
        accent-color: #2f7b35;
        cursor: pointer;
    }

    .filter-count {
        color: #909890;
        font-size: 11px;
    }

    .calories-select {
        width: 100%;
        padding: 9px 12px;
        border: 1px solid #dfe5dc;
        border-radius: 12px;
        background: #fff;
        color: #555f57;
        font-size: 12px;
        outline: none;
    }

    .clear-filter {
        width: 100%;
        margin-top: 20px;
        padding: 10px;
        border: none;
        border-radius: 24px;
        background: #eef6e9;
        color: #2e6c34;
        font-size: 12px;
        font-weight: 700;
        cursor: pointer;
    }

        .clear-filter:hover {
            background: #e2f0dc;
        }


    /* =====================================================
                       TOOLBAR
                       ===================================================== */

    .dishes-toolbar {
        margin-bottom: 14px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 15px;
    }

        .dishes-toolbar h2 {
            margin: 0;
            font-size: 27px;
            font-weight: 800;
        }

    .toolbar-right {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .sort-label {
        color: #707970;
        font-size: 12px;
    }

    .sort-select {
        padding: 8px 14px;
        border: 1px solid #dae2d7;
        border-radius: 18px;
        background: white;
        font-size: 12px;
        outline: none;
    }

    .add-dish-btn {
        padding: 10px 18px;
        display: inline-flex;
        align-items: center;
        gap: 7px;
        border-radius: 22px;
        background: #2f7b35;
        color: white;
        text-decoration: none;
        font-size: 13px;
        font-weight: 700;
    }

        .add-dish-btn:hover {
            background: #27692d;
            color: white;
        }


    /* =====================================================
                       DISH GRID
                       ===================================================== */

    .dish-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0,1fr));
        gap: 15px;
    }

    .dish-card {
        min-width: 0;
        position: relative;
        overflow: hidden;
        border: 1px solid #e5e9e3;
        border-radius: 16px;
        background: rgba(255,255,255,.96);
        box-shadow: 0 3px 11px rgba(0,0,0,.035);
        transition: transform .2s ease, box-shadow .2s ease;
    }

        .dish-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 10px 25px rgba(0,0,0,.075);
        }

        .dish-card.filtered-out {
            display: none;
        }


    /* =====================================================
                       DISH IMAGE
                       ===================================================== */

    .dish-image-wrapper {
        position: relative;
        height: 155px;
        overflow: hidden;
        background: #eceeef;
    }

        .dish-image-wrapper img {
            width: 100%;
            height: 100%;
            display: block;
            object-fit: cover;
            transition: transform .25s ease;
        }

    .dish-card:hover
    .dish-image-wrapper img {
        transform: scale(1.035);
    }

    .heart {
        position: absolute;
        top: 9px;
        right: 9px;
        width: 30px;
        height: 30px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        background: white;
        color: #e64d58;
        box-shadow: 0 3px 9px rgba(0,0,0,.13);
    }


    /* =====================================================
                       DISH BODY
                       ===================================================== */

    .dish-body {
        padding: 13px;
    }

    .dish-name {
        margin-bottom: 7px;
        color: #172019;
        font-size: 15px;
        font-weight: 800;
        line-height: 1.25;
    }

    .dish-tags {
        margin-bottom: 8px;
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
    }

    .dish-tag {
        padding: 3px 8px;
        display: inline-block;
        border-radius: 18px;
        background: #edf6e9;
        color: #33713b;
        font-size: 10px;
    }

    .dish-description {
        min-height: 30px;
        margin-bottom: 10px;
        color: #747c75;
        font-size: 11px;
        line-height: 1.35;
    }

    .dish-meta {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        color: #606a62;
        font-size: 10px;
    }

    .dish-actions {
        margin-top: 10px;
        padding-top: 9px;
        display: flex;
        gap: 6px;
        border-top: 1px solid #eef0ec;
    }

    .dish-action {
        flex: 1;
        padding: 5px;
        border-radius: 12px;
        background: #f4f7f2;
        color: #49604c;
        font-size: 10px;
        font-weight: 600;
        text-align: center;
        text-decoration: none;
    }

        .dish-action:hover {
            background: #ebf3e7;
            color: #2e6e35;
        }


    /* =====================================================
                       NO RESULTS
                       ===================================================== */

    .no-results {
        display: none;
        grid-column: 1 / -1;
        padding: 50px 20px;
        border-radius: 18px;
        background: rgba(255,255,255,.90);
        color: #687269;
        text-align: center;
    }

        .no-results.show {
            display: block;
        }


    /* =====================================================
                       RESPONSIVE
                       ===================================================== */

    @@media (max-width: 1250px) {

        .categories-row {
            grid-template-columns: repeat(4,1fr);
        }

        .dish-grid {
            grid-template-columns: repeat(3,1fr);
        }
    }

    @@media (max-width: 1000px) {

        .navbar-search {
            display: none;
        }
    }

    @@media (max-width: 950px) {

        .dishes-content {
            grid-template-columns: 1fr;
        }

        .dish-grid {
            grid-template-columns: repeat(2,1fr);
        }

        .hero-content {
            width: 75%;
        }
    }

    @@media (max-width: 760px) {

        .nav-content {
            width: calc(100% - 24px);
        }

        .nav-links {
            margin-left: 10px;
            gap: 14px;
        }

        .nav-link-custom {
            font-size: 12px;
        }
    }

    @@media (max-width: 700px) {

        .dishes-container {
            width: calc(100% - 24px);
        }

        .categories-row {
            grid-template-columns: repeat(2,1fr);
        }

        .dishes-hero {
            height: 340px;
            background-position: 65% center;
        }

        .hero-content {
            width: 100%;
            padding: 25px;
        }

        .hero-title {
            font-size: 43px;
        }

        .hero-text {
            font-size: 15px;
        }

        .dish-grid {
            grid-template-columns: 1fr;
        }

        .dishes-toolbar {
            flex-direction: column;
            align-items: flex-start;
        }
    }

    @@media (max-width: 620px) {

        .nav-links {
            display: none;
        }
    }

    .filter-form {
        display: block;
    }

    .filter-label {
        margin: 16px 0 7px;
        display: block;
        color: #253027;
        font-size: 13px;
        font-weight: 800;
    }

    .filter-select {
        width: 100%;
        padding: 9px 12px;
        border: 1px solid #dfe5dc;
        border-radius: 12px;
        background: #fff;
        color: #555f57;
        font-size: 12px;
        outline: none;
    }

    .filter-submit {
        width: 100%;
        margin-top: 18px;
        padding: 10px;
        border: none;
        border-radius: 24px;
        background: #2f7b35;
        color: white;
        font-size: 12px;
        font-weight: 800;
        cursor: pointer;
    }

    .filter-submit:hover {
        background: #27692d;
    }

    .category-link {
        color: inherit;
        text-decoration: none;
    }

    .pagination-custom {
        margin-top: 24px;
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 7px;
        flex-wrap: wrap;
    }

    .page-link-custom {
        min-width: 38px;
        height: 38px;
        padding: 0 11px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border: 1px solid #dce5d9;
        border-radius: 10px;
        background: white;
        color: #49604c;
        text-decoration: none;
        font-size: 12px;
        font-weight: 800;
    }

    .page-link-custom:hover {
        background: #eef6e9;
        color: #2f7036;
    }

    .page-link-custom.active {
        border-color: #2f7b35;
        background: #2f7b35;
        color: white;
    }

    .page-link-custom.disabled {
        opacity: .45;
        pointer-events: none;
    }

</style>

<div class="dishes-page">

    <div class="dishes-container">

        <section class="dishes-hero">

            <div class="hero-content">

                <div class="hero-kicker">
                    DISCOVER • COOK • ENJOY
                </div>

                <div class="hero-title">
                    Healthy <span>Recipes</span>
                </div>

                <p class="hero-text">
                    Browse our collection of nutritious and delicious recipes.
                    Search, filter and add them to your weekly menu.
                </p>

            </div>

        </section>


        <section class="categories-row">

            <a asp-controller="Dishes"
               asp-action="Index"
               class="category-card category-link @(Model.DishType == null ? "selected" : "")">

                <div class="category-icon-frame">
                    <span class="all-category-icon">🥗</span>
                </div>

                <div class="category-info">
                    <div class="category-name">All</div>
                    <div class="category-count">
                        @(Model.VegetarianCount +
                          Model.VeganCount +
                          Model.MeatCount +
                          Model.FishCount) recipes
                    </div>
                </div>

            </a>


            <a asp-controller="Dishes"
               asp-action="Index"
               asp-route-dishType="@DishType.Vegetarian"
               class="category-card category-link vegetarian @(Model.DishType == DishType.Vegetarian ? "selected" : "")">

                <div class="category-icon-frame">
                    <img src="~/images/Icons/vegetarian-icon.png"
                         alt="Vegetarian" />
                </div>

                <div class="category-info">
                    <div class="category-name">Vegetarian</div>
                    <div class="category-count">@Model.VegetarianCount recipes</div>
                </div>

            </a>


            <a asp-controller="Dishes"
               asp-action="Index"
               asp-route-dishType="@DishType.Vegan"
               class="category-card category-link vegan @(Model.DishType == DishType.Vegan ? "selected" : "")">

                <div class="category-icon-frame">
                    <img src="~/images/Icons/vegan-icon.png"
                         alt="Vegan" />
                </div>

                <div class="category-info">
                    <div class="category-name">Vegan</div>
                    <div class="category-count">@Model.VeganCount recipes</div>
                </div>

            </a>


            <a asp-controller="Dishes"
               asp-action="Index"
               asp-route-dishType="@DishType.Meat"
               class="category-card category-link meat @(Model.DishType == DishType.Meat ? "selected" : "")">

                <div class="category-icon-frame">
                    <img src="~/images/Icons/meat-icon.png"
                         alt="Meat" />
                </div>

                <div class="category-info">
                    <div class="category-name">Meat</div>
                    <div class="category-count">@Model.MeatCount recipes</div>
                </div>

            </a>


            <a asp-controller="Dishes"
               asp-action="Index"
               asp-route-dishType="@DishType.Fish"
               class="category-card category-link fish @(Model.DishType == DishType.Fish ? "selected" : "")">

                <div class="category-icon-frame">
                    <img src="~/images/Icons/fish-icon.png"
                         class="fish-icon"
                         alt="Fish" />
                </div>

                <div class="category-info">
                    <div class="category-name">Fish</div>
                    <div class="category-count">@Model.FishCount recipes</div>
                </div>

            </a>

        </section>


        <section class="dishes-content">

            <aside class="filter-sidebar">

                <form asp-controller="Dishes"
                      asp-action="Index"
                      method="get"
                      class="filter-form">

                    <div class="search-box">

                        🔍

                        <input name="search"
                               type="search"
                               value="@Model.Search"
                               placeholder="Search dishes..." />

                    </div>


                    <label class="filter-label"
                           for="dishType">
                        Dish Type
                    </label>

                    <select id="dishType"
                            name="dishType"
                            class="filter-select">

                        <option value="">
                            All types
                        </option>

                        @foreach (DishType type
                                  in Enum.GetValues<DishType>())
                        {
                            <option value="@type"
                                    selected="@(Model.DishType == type)">
                                @type
                            </option>
                        }

                    </select>


                    <label class="filter-label"
                           for="cookingTime">
                        Cooking Time
                    </label>

                    <select id="cookingTime"
                            name="cookingTime"
                            class="filter-select">

                        <option value=""
                                selected="@(string.IsNullOrWhiteSpace(Model.CookingTime))">
                            Any
                        </option>

                        <option value="under15"
                                selected="@(Model.CookingTime == "under15")">
                            Under 15 min
                        </option>

                        <option value="15to30"
                                selected="@(Model.CookingTime == "15to30")">
                            15 - 30 min
                        </option>

                        <option value="over30"
                                selected="@(Model.CookingTime == "over30")">
                            Over 30 min
                        </option>

                    </select>


                    <label class="filter-label"
                           for="calories">
                        Calories
                    </label>

                    <select id="calories"
                            name="calories"
                            class="filter-select">

                        <option value=""
                                selected="@(string.IsNullOrWhiteSpace(Model.Calories))">
                            Any
                        </option>

                        <option value="under350"
                                selected="@(Model.Calories == "under350")">
                            Under 350 kcal
                        </option>

                        <option value="350to450"
                                selected="@(Model.Calories == "350to450")">
                            350 - 450 kcal
                        </option>

                        <option value="451to550"
                                selected="@(Model.Calories == "451to550")">
                            451 - 550 kcal
                        </option>

                        <option value="over550"
                                selected="@(Model.Calories == "over550")">
                            Over 550 kcal
                        </option>

                    </select>


                    <label class="filter-label"
                           for="sortBy">
                        Sort By
                    </label>

                    <select id="sortBy"
                            name="sortBy"
                            class="filter-select">

                        <option value=""
                                selected="@(string.IsNullOrWhiteSpace(Model.SortBy))">
                            Newest
                        </option>

                        <option value="nameAsc"
                                selected="@(Model.SortBy == "nameAsc")">
                            Name A-Z
                        </option>

                        <option value="caloriesAsc"
                                selected="@(Model.SortBy == "caloriesAsc")">
                            Calories: Low to High
                        </option>

                        <option value="caloriesDesc"
                                selected="@(Model.SortBy == "caloriesDesc")">
                            Calories: High to Low
                        </option>

                    </select>


                    <button type="submit"
                            class="filter-submit">
                        Apply Filters
                    </button>


                    <a asp-controller="Dishes"
                       asp-action="Index"
                       class="clear-filter category-link">
                        ↻ Clear Filters
                    </a>

                </form>

            </aside>


            <main class="dishes-main">

                <div class="dishes-toolbar">

                    <h2>
                        @Model.TotalItems Dishes
                    </h2>

                    <div class="toolbar-right">

                        <span class="sort-label">
                            Page @Model.CurrentPage of @Model.TotalPages
                        </span>

                        <a asp-controller="Dishes"
                           asp-action="Add"
                           class="add-dish-btn">
                            ＋ Add Dish
                        </a>

                    </div>

                </div>


                <div class="dish-grid">

                    @if (dishes.Any())
                    {
                        @foreach (DishIndexViewModel dish
                                  in dishes)
                        {
                            string imagePath;

                            if (!string.IsNullOrWhiteSpace(
                                    dish.ImageUrl))
                            {
                                imagePath =
                                    dish.ImageUrl;
                            }
                            else if (dishImages.ContainsKey(
                                         dish.Name))
                            {
                                imagePath =
                                    dishImages[dish.Name];
                            }
                            else
                            {
                                imagePath =
                                    "/images/DishesImages/unadded.png";
                            }


                            <article class="dish-card">

                                <div class="dish-image-wrapper">

                                    <img src="@imagePath"
                                         alt="@dish.Name"
                                         onerror="this.onerror=null; this.src='/images/DishesImages/unadded.png';" />

                                    <div class="heart">
                                        ♥
                                    </div>

                                </div>


                                <div class="dish-body">

                                    <div class="dish-name">
                                        @dish.Name
                                    </div>

                                    <div class="dish-tags">

                                        <span class="dish-tag">
                                            @dish.DishType
                                        </span>

                                        @if (dish.IsShared)
                                        {
                                            <span class="dish-tag">
                                                Example
                                            </span>
                                        }

                                    </div>

                                    <div class="dish-description">
                                        @dish.Description
                                    </div>

                                    <div class="dish-meta">

                                        <span>
                                            🔥 @dish.Calories kcal
                                        </span>

                                        <span>
                                            ⏱ @dish.PreparationTime min
                                        </span>

                                        <span>
                                            👥 @dish.Portions servings
                                        </span>

                                    </div>

                                    <div class="dish-actions">

                                        <a asp-controller="Dishes"
                                           asp-action="Details"
                                           asp-route-id="@dish.Id"
                                           class="dish-action">
                                            Details
                                        </a>

                                        @if (!dish.IsShared)
                                        {
                                            <a asp-controller="Dishes"
                                               asp-action="Edit"
                                               asp-route-id="@dish.Id"
                                               class="dish-action">
                                                Edit
                                            </a>

                                            <a asp-controller="Dishes"
                                               asp-action="Delete"
                                               asp-route-id="@dish.Id"
                                               class="dish-action">
                                                Delete
                                            </a>
                                        }

                                    </div>

                                </div>

                            </article>
                        }
                    }
                    else
                    {
                        <div class="no-results show">

                            <h4>
                                No dishes found
                            </h4>

                            <p>
                                Try changing or clearing your filters.
                            </p>

                        </div>
                    }

                </div>


                @if (Model.TotalPages > 1)
                {
                    <nav class="pagination-custom"
                         aria-label="Dishes pages">

                        <a asp-controller="Dishes"
                           asp-action="Index"
                           asp-route-search="@Model.Search"
                           asp-route-dishType="@Model.DishType"
                           asp-route-cookingTime="@Model.CookingTime"
                           asp-route-calories="@Model.Calories"
                           asp-route-sortBy="@Model.SortBy"
                           asp-route-page="@(Model.CurrentPage - 1)"
                           class="page-link-custom @(Model.CurrentPage <= 1 ? "disabled" : "")">
                            ←
                        </a>


                        @for (int page = 1;
                              page <= Model.TotalPages;
                              page++)
                        {
                            <a asp-controller="Dishes"
                               asp-action="Index"
                               asp-route-search="@Model.Search"
                               asp-route-dishType="@Model.DishType"
                               asp-route-cookingTime="@Model.CookingTime"
                               asp-route-calories="@Model.Calories"
                               asp-route-sortBy="@Model.SortBy"
                               asp-route-page="@page"
                               class="page-link-custom @(page == Model.CurrentPage ? "active" : "")">
                                @page
                            </a>
                        }


                        <a asp-controller="Dishes"
                           asp-action="Index"
                           asp-route-search="@Model.Search"
                           asp-route-dishType="@Model.DishType"
                           asp-route-cookingTime="@Model.CookingTime"
                           asp-route-calories="@Model.Calories"
                           asp-route-sortBy="@Model.SortBy"
                           asp-route-page="@(Model.CurrentPage + 1)"
                           class="page-link-custom @(Model.CurrentPage >= Model.TotalPages ? "disabled" : "")">
                            →
                        </a>

                    </nav>
                }

            </main>

        </section>

    </div>

</div>
