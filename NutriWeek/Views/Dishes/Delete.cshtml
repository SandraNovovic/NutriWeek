@using NutriWeek.Web.ViewModels.Dishes
@model DeleteDishViewModel

@{
    ViewData["Title"] = "Delete Dish";
}

<style>
    body > header,
    body > footer {
        display: none;
    }

    body {
        margin: 0;
        padding: 0;
        background: #f7faf5;
    }

        body > .container {
            width: 100% !important;
            max-width: none !important;
            margin: 0 !important;
            padding: 0 !important;
        }

            body > .container > main {
                margin: 0 !important;
                padding: 0 !important;
            }



    .delete-page {
        position: relative;
        left: 50%;
        width: 100vw;
        min-height: calc(100vh - 74px);
        margin-left: -50vw;
        padding-bottom: 70px;
        background-image: linear-gradient(rgba(249,252,247,.88), rgba(249,252,247,.92)), url('@Url.Content("~/images/DishesImages/add_dish_background.png")');
        background-size: cover;
        background-position: center top;
        background-attachment: fixed;
    }

    .page-heading-area {
        padding: 28px 0 30px;
        background: linear-gradient( 90deg, rgba(239,247,234,.92), rgba(255,255,255,.55) );
        border-bottom: 1px solid rgba(221,230,218,.8);
    }

    .page-width {
        width: min(1380px, calc(100% - 50px));
        margin: 0 auto;
    }

    .breadcrumb-row {
        margin-bottom: 10px;
        display: flex;
        align-items: center;
        gap: 9px;
        color: #56805a;
        font-size: 13px;
    }

        .breadcrumb-row a {
            color: #56805a;
            text-decoration: none;
        }

    .page-title {
        margin: 0 0 8px;
        color: #102018;
        font-size: 41px;
        font-weight: 800;
    }

    .page-subtitle {
        margin: 0;
        color: #516256;
        font-size: 16px;
    }

    .delete-shell {
        width: min(850px, calc(100% - 50px));
        margin: 32px auto 0;
        padding: 28px;
        border: 1px solid rgba(224,231,221,.95);
        border-radius: 24px;
        background: rgba(255,255,255,.96);
        box-shadow: 0 12px 40px rgba(38,61,41,.07);
    }

    .warning-box {
        margin-bottom: 26px;
        padding: 18px;
        display: flex;
        align-items: center;
        gap: 14px;
        border: 1px solid #f0caca;
        border-radius: 14px;
        background: linear-gradient(90deg, #fff0f0, #fff6f6);
    }

    .warning-icon {
        width: 43px;
        height: 43px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        border-radius: 50%;
        background: #df4c4c;
        color: white;
        font-size: 22px;
        font-weight: 900;
    }

    .warning-title {
        margin-bottom: 4px;
        color: #b72e2e;
        font-size: 16px;
        font-weight: 900;
    }

    .warning-text {
        margin: 0;
        color: #b85050;
        font-size: 12px;
    }

    .dish-summary {
        padding: 22px;
        border: 1px solid #e4ebe1;
        border-radius: 16px;
        background: #fafcf9;
        text-align: center;
    }

    .dish-summary-icon {
        width: 76px;
        height: 76px;
        margin: 0 auto 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        background: #edf5e9;
        font-size: 34px;
    }

    .dish-name {
        margin: 0 0 7px;
        color: #17231a;
        font-size: 25px;
        font-weight: 900;
    }

    .dish-id {
        color: #8a948c;
        font-size: 11px;
    }

    .confirm-text {
        margin: 22px 0 0;
        color: #59655c;
        font-size: 13px;
        line-height: 1.6;
        text-align: center;
    }

    .actions {
        margin-top: 25px;
        padding-top: 20px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 14px;
        border-top: 1px solid #e7ece5;
    }

    .btn-custom {
        min-width: 170px;
        padding: 12px 22px;
        border-radius: 27px;
        font-size: 13px;
        font-weight: 800;
        text-align: center;
        cursor: pointer;
        transition: .2s ease;
    }

    .cancel-button {
        border: 1px solid #a7b9a4;
        background: white;
        color: #355a39;
        text-decoration: none;
    }

    .delete-button {
        border: none;
        background: linear-gradient(90deg, #d94b4b, #ea5b5b);
        color: white;
        box-shadow: 0 5px 14px rgba(205,64,64,.18);
    }

    .btn-custom:hover {
        transform: translateY(-1px);
    }

    @@media (max-width: 700px) {
        .page-width,
        .delete-shell,
        .nav-content {
            width: calc(100% - 24px);
        }

        .nav-links {
            display: none;
        }

        .navbar-search {
            display: none;
        }

        .actions {
            flex-direction: column-reverse;
        }

        .btn-custom {
            width: 100%;
        }
    }
</style>

@await Html.PartialAsync("_NutriNavbar")

<div class="delete-page">

    <section class="page-heading-area">

        <div class="page-width">

            <div class="breadcrumb-row">

                <a asp-controller="Dishes"
                   asp-action="Index">
                    Dishes
                </a>

                <span>›</span>

                <span>Delete Dish</span>

            </div>

            <h1 class="page-title">
                Delete Dish
            </h1>

            <p class="page-subtitle">
                Are you sure you want to delete this dish?
            </p>

        </div>

    </section>

    <div class="delete-shell">

        <div class="warning-box">

            <div class="warning-icon">
                !
            </div>

            <div>

                <div class="warning-title">
                    Confirm Deletion
                </div>

                <p class="warning-text">
                    This action will permanently delete the dish from the system.
                </p>

            </div>

        </div>

        <div class="dish-summary">

            <div class="dish-summary-icon">
                🍽
            </div>

            <h2 class="dish-name">
                @Model.Name
            </h2>

            <div class="dish-id">
                Dish ID: @Model.Id
            </div>

        </div>

        <p class="confirm-text">
            Once deleted, this dish cannot be restored.
            Make sure you really want to remove
            <strong>@Model.Name</strong>.
        </p>

        <form asp-controller="Dishes"
              asp-action="Delete"
              asp-route-id="@Model.Id"
              method="post">

            @Html.AntiForgeryToken()

            <input asp-for="Id"
                   type="hidden" />

            <div class="actions">

                <a asp-controller="Dishes"
                   asp-action="Index"
                   class="btn-custom cancel-button">

                    ← Cancel

                </a>

                <button type="submit"
                        class="btn-custom delete-button">

                    🗑 Delete Dish

                </button>

            </div>

        </form>

    </div>

</div>
