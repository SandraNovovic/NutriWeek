@{
    ViewData["Title"] = "Page Not Found";
}

<style>

    .error-page {
        min-height: 70vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 50px 20px;
    }

    .error-card {
        width: min(680px, 100%);
        padding: 48px 34px;
        border: 1px solid #dfe8dc;
        border-radius: 24px;
        background: #ffffff;
        box-shadow: 0 18px 45px rgba(38, 67, 43, .08);
        text-align: center;
    }

    .error-code {
        margin-bottom: 5px;
        color: #3f8947;
        font-size: 82px;
        font-weight: 950;
        line-height: 1;
        letter-spacing: -.06em;
    }

    .error-title {
        margin: 0;
        color: #1e3527;
        font-size: 30px;
        font-weight: 900;
    }

    .error-text {
        max-width: 500px;
        margin: 12px auto 24px;
        color: #78837b;
        font-size: 14px;
        line-height: 1.7;
    }

    .error-actions {
        display: flex;
        justify-content: center;
        gap: 10px;
        flex-wrap: wrap;
    }

    .error-button {
        min-width: 140px;
        padding: 11px 16px;
        border-radius: 12px;
        text-decoration: none;
        font-size: 12px;
        font-weight: 900;
    }

    .error-button.primary {
        background: #3f8947;
        color: white;
    }

    .error-button.secondary {
        border: 1px solid #d4e2d1;
        background: #f7faf5;
        color: #427448;
    }

</style>


<div class="error-page">

    <section class="error-card">

        <div class="error-code">
            404
        </div>

        <h1 class="error-title">
            Page not found
        </h1>

        <p class="error-text">
            The page you are looking for does not exist,
            may have been moved, or the address may be incorrect.
        </p>

        <div class="error-actions">

            <a asp-controller="Home"
               asp-action="Index"
               class="error-button primary">
                Go to Home
            </a>

            <a asp-controller="Dishes"
               asp-action="Index"
               class="error-button secondary">
                Browse Dishes
            </a>

        </div>

    </section>

</div>
