@using NutriWeek.Data.Models;
@model IEnumerable<WeeklyMenu>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>All Weekly Menus</h1>

    <a href="#" class="btn btn-success">
        Add Weekly Menu
    </a>
    <a href="#" class="btn btn-success">
        Delete Weekly Menu
    </a>
</div>

@foreach (var weeklyMenu in Model)
{
    <h3>@weeklyMenu.Id</h3>

    <p>@weeklyMenu.WeekStartDate</p>

    @foreach (var dailyMenu in weeklyMenu.DailyMenus)
    {
        <p>
            <strong>@dailyMenu.Date</strong>

            @foreach (var meal in dailyMenu.Meals)
            {
            <p>
                <strong>@meal.MealType:</strong>
                @meal.Dish.Name
                - @meal.Dish.Calories kcal
            </p>
            }
        </p>
    }

    <hr />
}