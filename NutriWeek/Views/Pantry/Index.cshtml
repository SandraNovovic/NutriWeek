@{
    ViewData["Title"] = "My Pantry";
}

@Html.AntiForgeryToken()

<div class="container py-4">

    <div class="mb-4">
        <h1>My Pantry</h1>
        <p class="text-muted">
            Keep track of the ingredients you currently have at home.
        </p>
    </div>

    <div id="pantryAlert"></div>

    <div class="card shadow-sm mb-4">
        <div class="card-body">

            <h5 class="card-title mb-3">
                Add Ingredient
            </h5>

            <form id="addPantryForm"
                  class="row g-3">

                <div class="col-md-5">
                    <label for="ingredientName"
                           class="form-label">
                        Ingredient
                    </label>

                    <input type="text"
                           id="ingredientName"
                           class="form-control"
                           maxlength="100"
                           required />
                </div>

                <div class="col-md-3">
                    <label for="quantity"
                           class="form-label">
                        Quantity
                    </label>

                    <input type="number"
                           id="quantity"
                           class="form-control"
                           min="0.01"
                           step="0.01"
                           required />
                </div>

                <div class="col-md-2">
                    <label for="unit"
                           class="form-label">
                        Unit
                    </label>

                    <select id="unit"
                            class="form-select"
                            required>
                    </select>
                </div>

                <div class="col-md-2 d-flex align-items-end">
                    <button type="submit"
                            class="btn btn-primary w-100">
                        Add
                    </button>
                </div>

            </form>

        </div>
    </div>


    <div class="card shadow-sm">
        <div class="card-body">

            <h5 class="card-title mb-3">
                Pantry Items
            </h5>

            <div id="emptyPantry"
                 class="text-center text-muted py-4 d-none">

                Your pantry is empty.

            </div>

            <div class="table-responsive"
                 id="pantryTableContainer">

                <table class="table align-middle">
                    <thead>
                        <tr>
                            <th>Ingredient</th>
                            <th>Quantity</th>
                            <th>Unit</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>

                    <tbody id="pantryTableBody">
                    </tbody>

                </table>

            </div>

        </div>
    </div>

</div>


<div class="modal fade"
     id="editPantryModal"
     tabindex="-1"
     aria-hidden="true">

    <div class="modal-dialog">

        <div class="modal-content">

            <div class="modal-header">

                <h5 class="modal-title">
                    Edit Pantry Item
                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal">
                </button>

            </div>

            <div class="modal-body">

                <input type="hidden"
                       id="editPantryItemId" />

                <div class="mb-3">

                    <label class="form-label">
                        Ingredient
                    </label>

                    <input type="text"
                           id="editIngredientName"
                           class="form-control"
                           readonly />

                </div>

                <div class="mb-3">

                    <label for="editQuantity"
                           class="form-label">
                        Quantity
                    </label>

                    <input type="number"
                           id="editQuantity"
                           class="form-control"
                           min="0.01"
                           step="0.01"
                           required />

                </div>

                <div class="mb-3">

                    <label for="editUnit"
                           class="form-label">
                        Unit
                    </label>

                    <select id="editUnit"
                            class="form-select">
                    </select>

                </div>

            </div>

            <div class="modal-footer">

                <button type="button"
                        class="btn btn-secondary"
                        data-bs-dismiss="modal">
                    Cancel
                </button>

                <button type="button"
                        id="saveEditButton"
                        class="btn btn-primary">
                    Save
                </button>

            </div>

        </div>

    </div>

</div>


@section Scripts
{
    <script src="~/js/pantry.js"
            asp-append-version="true">
    </script>
}