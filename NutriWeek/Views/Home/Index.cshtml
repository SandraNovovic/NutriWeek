<style>

    /* ==========================
           REMOVE DEFAULT MVC LAYOUT
           ========================== */

    body > header {
        display: none;
    }

    body > footer {
        display: none;
    }

    body {
        margin: 0;
        padding: 0;
        background: #f8faf5;
    }

        body > .container {
            max-width: none !important;
            width: 100% !important;
            padding: 0 !important;
            margin: 0 !important;
        }

            body > .container > main {
                padding: 0 !important;
                margin: 0 !important;
            }


    /* ==========================
           FULL PAGE
           ========================== */

    .nutriweek-page {
        width: 100vw;
        min-height: 100vh;
        position: relative;
        left: 50%;
        margin-left: -50vw;
        background: linear-gradient( 180deg, #f8faf5 0%, #ffffff 45%, #f2f7ed 100% );
        font-family: Arial, Helvetica, sans-serif;
        color: #172019;
        overflow: hidden;
    }


    .page-container {
        width: min(1400px, calc(100% - 50px));
        margin: auto;
    }


    /* ==========================
           NAVBAR
           ========================== */

    .nutri-navbar {
        width: 100%;
        height: 76px;
        background: rgba(255, 255, 255, 0.97);
        border-bottom: 1px solid #edf0ea;
        display: flex;
        align-items: center;
        position: sticky;
        top: 0;
        z-index: 100;
    }

    .nav-content {
        width: min(1400px, calc(100% - 50px));
        margin: auto;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }


    .brand {
        display: flex;
        align-items: center;
        gap: 8px;
        text-decoration: none;
        color: #121b14;
        font-size: 24px;
        font-weight: 800;
    }

        .brand:hover {
            color: #121b14;
        }


    .brand-leaf {
        font-size: 26px;
        color: #2f7b35;
    }


    .nav-center {
        display: flex;
        align-items: center;
        gap: 32px;
    }


        .nav-center a {
            text-decoration: none;
            font-size: 15px;
            font-weight: 500;
            color: #333c35;
            padding: 27px 2px 23px;
            position: relative;
        }


            .nav-center a:hover {
                color: #2f7b35;
            }


        .nav-center .active {
            color: #2f7b35;
        }


            .nav-center .active::after {
                content: "";
                position: absolute;
                bottom: 15px;
                left: 0;
                width: 100%;
                height: 3px;
                border-radius: 10px;
                background: #2f7b35;
            }


    .nav-search {
        width: 270px;
        border: 1px solid #dde4da;
        border-radius: 30px;
        display: flex;
        align-items: center;
        background: #fbfcfa;
        padding: 8px 15px;
    }


        .nav-search input {
            width: 100%;
            border: 0;
            outline: 0;
            background: transparent;
            font-size: 14px;
        }


    .search-icon {
        color: #9ba49c;
        font-size: 16px;
    }



    /* ==========================
           HERO
           ========================== */

    .hero {
        position: relative;
        height: 490px;
        margin-bottom: 22px;
        background-image: url('@Url.Content("~/images/HomePageImages/hero_chicken_bowl.png")');
        background-size: cover;
        background-position: center;
        display: flex;
        align-items: center;
    }


    .hero-content {
        width: 50%;
        padding-left: 38px;
    }


    .hero-small {
        font-size: 13px;
        letter-spacing: 3px;
        font-weight: 700;
        margin-bottom: 14px;
    }


    .hero-name {
        font-size: 67px;
        font-weight: 800;
        line-height: 1;
        margin-bottom: 8px;
        color: #101612;
    }


        .hero-name span {
            color: #2f7b35;
        }


    .hero-slogan {
        font-size: 31px;
        font-weight: 800;
        margin-bottom: 16px;
    }


    .hero-description {
        max-width: 530px;
        font-size: 18px;
        line-height: 1.5;
        margin-bottom: 25px;
        color: #39433b;
    }


    .hero-buttons {
        display: flex;
        gap: 14px;
    }


    .hero-primary,
    .hero-secondary {
        border-radius: 22px;
        padding: 14px 23px;
        font-size: 16px;
        font-weight: 600;
        text-decoration: none;
        display: inline-flex;
        gap: 8px;
        align-items: center;
    }


    .hero-primary {
        background: #2f7b35;
        color: #fff;
        box-shadow: 0 5px 14px rgba(47, 123, 53, 0.17);
    }


        .hero-primary:hover {
            background: #25682b;
            color: #fff;
        }


    .hero-secondary {
        background: rgba(255,255,255,0.85);
        border: 1px solid #cad5c7;
        color: #29422d;
    }


        .hero-secondary:hover {
            background: #fff;
            color: #29422d;
        }



    /* ==========================
           THREE IMAGE CARDS
           ========================== */

    .quick-section {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 20px;
        margin-bottom: 25px;
    }


    .quick-image-card {
        width: 100%;
        height: 230px;
        display: block;
        border-radius: 20px;
        overflow: hidden;
        box-shadow: 0 4px 13px rgba(0,0,0,0.05);
        transition: transform .2s ease, box-shadow .2s ease;
    }


        .quick-image-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 10px 25px rgba(0,0,0,.08);
        }


        .quick-image-card img {
            display: block;
            width: 100%;
            height: 100%;
            object-fit: cover;
            object-position: center;
        }



    /* ==========================
           SECTION BOX
           ========================== */

    .main-box {
        background: rgba(255,255,255,.82);
        border: 1px solid #e7ebe4;
        border-radius: 20px;
        padding: 27px;
        margin-bottom: 25px;
        box-shadow: 0 5px 18px rgba(35,60,37,.035);
    }


    .section-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 23px;
    }


        .section-header h2 {
            font-size: 29px;
            font-weight: 800;
            margin: 0 0 3px;
        }


        .section-header p {
            margin: 0;
            color: #758077;
            font-size: 15px;
        }


    .view-button {
        padding: 10px 20px;
        border-radius: 25px;
        border: 1px solid #9fb49b;
        background: rgba(255,255,255,.8);
        text-decoration: none;
        color: #315f35;
        font-size: 14px;
        font-weight: 600;
    }


        .view-button:hover {
            color: #315f35;
            background: #f2f7ef;
        }



    /* ==========================
           THIS WEEK
           ========================== */

    .week-grid {
        display: grid;
        grid-template-columns: repeat(5, 1fr);
        gap: 13px;
    }


    .week-card {
        border: 1px solid #e7ebe6;
        border-radius: 14px;
        background: #fff;
        padding: 14px;
        min-height: 225px;
    }


        .week-card h5 {
            font-size: 16px;
            font-weight: 700;
            margin-bottom: 1px;
        }


    .week-date {
        color: #929a93;
        font-size: 12px;
        margin-bottom: 12px;
    }


    .week-meal {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 12px;
    }


        .week-meal img {
            width: 37px;
            height: 37px;
            min-width: 37px;
            object-fit: cover;
            border-radius: 50%;
            border: 1px solid #ecefe8;
        }


    .week-type {
        display: block;
        font-size: 11px;
        margin-bottom: 1px;
    }


    .breakfast-text {
        color: #3c8244;
    }


    .lunch-text {
        color: #cb8b24;
    }


    .dinner-text {
        color: #d0574e;
    }


    .week-dish {
        font-size: 12px;
        font-weight: 600;
        line-height: 1.2;
    }



    /* ==========================
           POPULAR DISHES
           ========================== */

    .popular-box {
        padding: 24px;
    }


    .popular-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 15px;
        max-width: 1200px;
        margin: auto;
    }


    .popular-card {
        background: #fff;
        border: 1px solid #e7eae5;
        border-radius: 15px;
        overflow: hidden;
        box-shadow: 0 3px 10px rgba(0,0,0,.035);
    }


    .popular-image {
        height: 160px;
        position: relative;
    }


        .popular-image img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }


    .popular-heart {
        position: absolute;
        top: 9px;
        right: 9px;
        width: 27px;
        height: 27px;
        background: #fff;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #dc5656;
        font-size: 13px;
    }


    .popular-body {
        padding: 12px;
    }


    .popular-title {
        font-size: 15px;
        font-weight: 700;
        margin-bottom: 6px;
    }


    .tags {
        display: flex;
        gap: 5px;
        margin-bottom: 8px;
    }


    .tag {
        padding: 3px 8px;
        border-radius: 20px;
        font-size: 10px;
        background: #edf5e8;
        color: #34723b;
    }


    .meal-tag {
        background: #fff2e2;
        color: #c88027;
    }


    .dinner-tag {
        background: #fdeaea;
        color: #cc5757;
    }


    .popular-description {
        color: #7a817b;
        font-size: 11px;
        line-height: 1.35;
        min-height: 31px;
        margin-bottom: 8px;
    }


    .popular-info {
        display: flex;
        flex-wrap: wrap;
        gap: 9px;
        font-size: 10px;
        color: #687069;
    }



    /* ==========================
           BENEFITS
           ========================== */

    .benefits {
        min-height: 155px;
        position: relative;
        margin-top: 20px;
        padding: 35px 35px;
        background: linear-gradient( 180deg, #eff6e9 0%, #eaf3e3 100% );
        border-radius: 22px 22px 0 0;
        overflow: hidden;
    }


    .benefits-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 25px;
        position: relative;
        z-index: 2;
    }


    .benefit {
        display: flex;
        align-items: flex-start;
        gap: 11px;
    }


    .benefit-icon {
        width: 45px;
        height: 45px;
        min-width: 45px;
        border-radius: 50%;
        background: rgba(255,255,255,.9);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 19px;
    }


    .benefit h6 {
        font-size: 14px;
        font-weight: 700;
        margin-bottom: 4px;
    }


    .benefit p {
        font-size: 11px;
        line-height: 1.4;
        color: #626c63;
        margin: 0;
    }


    .decor-left {
        position: absolute;
        width: 170px;
        left: -10px;
        bottom: -15px;
        opacity: .55;
    }


    .decor-right {
        position: absolute;
        width: 190px;
        right: -20px;
        bottom: -25px;
        opacity: .4;
        transform: scaleX(-1);
    }



    /* ==========================
           RESPONSIVE
           ========================== */

    @@media (max-width: 1100px) {

        .nav-search {
            display: none;
        }

        .week-grid {
            grid-template-columns: repeat(3, 1fr);
        }
    }


    @@media (max-width: 850px) {

        .nav-center {
            display: none;
        }

        .hero {
            height: 450px;
        }

        .hero-content {
            width: 70%;
        }

        .hero-name {
            font-size: 50px;
        }

        .quick-section {
            grid-template-columns: 1fr;
        }

        .quick-image-card {
            height: auto;
        }

            .quick-image-card img {
                height: auto;
            }

        .week-grid {
            grid-template-columns: repeat(2, 1fr);
        }

        .popular-grid {
            grid-template-columns: repeat(2, 1fr);
        }

        .benefits-grid {
            grid-template-columns: repeat(2, 1fr);
        }
    }


    @@media (max-width: 550px) {

        .page-container,
        .nav-content {
            width: calc(100% - 24px);
        }

        .hero {
            height: 500px;
            background-position: 62% center;
        }

        .hero-content {
            width: 100%;
            padding: 25px;
        }

        .hero-name {
            font-size: 43px;
        }

        .hero-slogan {
            font-size: 23px;
        }

        .hero-description {
            font-size: 15px;
        }

        .week-grid,
        .popular-grid,
        .benefits-grid {
            grid-template-columns: 1fr;
        }

        .section-header {
            align-items: flex-start;
            gap: 15px;
            flex-direction: column;
        }
    }

</style>



<div class="nutriweek-page">


    <!-- ================= NAVIGATION ================= -->

    <nav class="nutri-navbar">

        <div class="nav-content">

            <a asp-controller="Home"
               asp-action="Index"
               class="brand">

                <span class="brand-leaf">🌿</span>

                NutriWeek

            </a>


            <div class="nav-center">

                <a asp-controller="Home"
                   asp-action="Index"
                   class="active">
                    Home
                </a>

                <a asp-controller="Dishes"
                   asp-action="Index">
                    Dishes
                </a>

                <a asp-controller="DailyMenus"
                   asp-action="Index">
                    Daily Menu
                </a>

                <a asp-controller="WeeklyMenus"
                   asp-action="Index">
                    Weekly Menu
                </a>

                <a asp-controller="Meals"
                   asp-action="Index">
                    Meals
                </a>

            </div>


            <div class="nav-search">

                <span class="search-icon">
                    🔍
                </span>

                <input type="text"
                       placeholder="Search dishes..." />

            </div>

        </div>

    </nav>



    <!-- ================= HERO ================= -->

    <section class="hero">

        <div class="page-container">

            <div class="hero-content">

                <div class="hero-small">
                    HEALTHY FOOD • BETTER HABITS
                </div>


                <div class="hero-name">
                    Nutri<span>Week</span>
                </div>


                <div class="hero-slogan">
                    Eat better. Plan smarter.
                </div>


                <div class="hero-description">

                    Create your weekly meal plan,
                    discover healthy recipes and keep track
                    of your meals in one place.

                </div>


                <div class="hero-buttons">

                    <a asp-controller="WeeklyMenus"
                       asp-action="Index"
                       class="hero-primary">

                        📅 Plan My Week

                    </a>


                    <a asp-controller="Dishes"
                       asp-action="Index"
                       class="hero-secondary">

                        🍴 Browse Dishes

                    </a>

                </div>

            </div>

        </div>

    </section>



    <div class="page-container">


        <!-- ================= QUICK LINKS ================= -->

        <section class="quick-section">


            <a asp-controller="Dishes"
               asp-action="Index"
               class="quick-image-card">

                <img src="~/images/HomePageImages/dishes_salad_bowl.png"
                     alt="Dishes" />

            </a>



            <a asp-controller="WeeklyMenus"
               asp-action="Index"
               class="quick-image-card">

                <img src="~/images/HomePageImages/weekly_plan_notebook.png"
                     alt="Weekly Menu" />

            </a>



            <a asp-controller="DailyMenus"
               asp-action="Index"
               class="quick-image-card">

                <img src="~/images/HomePageImages/daily_menu_salmon.png"
                     alt="Daily Menu" />

            </a>


        </section>



        <!-- ================= THIS WEEK ================= -->

        <section class="main-box">

            <div class="section-header">

                <div>

                    <h2>This Week</h2>

                    <p>
                        Your planned meals at a glance.
                    </p>

                </div>


                <a asp-controller="WeeklyMenus"
                   asp-action="Index"
                   class="view-button">

                    View Full Week →

                </a>

            </div>



            <div class="week-grid">

                @foreach (var day in weekPlan)
                {

                    <div class="week-card">


                        <h5>
                            @day.Day
                        </h5>


                        <div class="week-date">
                            @day.Date
                        </div>



                        <div class="week-meal">

                            <img src="@Url.Content(day.BreakfastImage)"
                                 alt="@day.Breakfast" />

                            <div>

                                <span class="week-type breakfast-text">
                                    Breakfast
                                </span>

                                <div class="week-dish">
                                    @day.Breakfast
                                </div>

                            </div>

                        </div>



                        <div class="week-meal">

                            <img src="@Url.Content(day.LunchImage)"
                                 alt="@day.Lunch" />

                            <div>

                                <span class="week-type lunch-text">
                                    Lunch
                                </span>

                                <div class="week-dish">
                                    @day.Lunch
                                </div>

                            </div>

                        </div>



                        <div class="week-meal">

                            <img src="@Url.Content(day.DinnerImage)"
                                 alt="@day.Dinner" />

                            <div>

                                <span class="week-type dinner-text">
                                    Dinner
                                </span>

                                <div class="week-dish">
                                    @day.Dinner
                                </div>

                            </div>

                        </div>


                    </div>

                }

            </div>

        </section>



        <!-- ================= POPULAR DISHES ================= -->

        <section class="main-box popular-box">

            <div class="section-header">

                <div>

                    <h2>
                        Popular Dishes
                    </h2>

                    <p>
                        Try some of our most popular healthy recipes.
                    </p>

                </div>


                <a asp-controller="Dishes"
                   asp-action="Index"
                   class="view-button">

                    View All Dishes →

                </a>

            </div>



            <div class="popular-grid">


                @foreach (var dish in popularDishes)
                {

                    string mealClass =
                    dish.MealType == "Dinner"
                    ? "dinner-tag"
                    : "meal-tag";


                    <div class="popular-card">


                        <div class="popular-image">

                            <img src="@Url.Content(dish.Image)"
                                 alt="@dish.Name" />


                            <div class="popular-heart">
                                ♥
                            </div>

                        </div>



                        <div class="popular-body">


                            <div class="popular-title">

                                @dish.Name

                            </div>



                            <div class="tags">


                                <span class="tag @mealClass">

                                    @dish.MealType

                                </span>


                                <span class="tag">

                                    @dish.DishType

                                </span>


                            </div>



                            <div class="popular-description">

                                @dish.Description

                            </div>



                            <div class="popular-info">

                                <span>
                                    🔥 @dish.Calories
                                </span>

                                <span>
                                    ⏱ @dish.Time
                                </span>

                                <span>
                                    👥 @dish.Servings
                                </span>

                            </div>


                        </div>

                    </div>

                }


            </div>

        </section>



        <!-- ================= BENEFITS ================= -->

        <section class="benefits">


            <img src="~/images/Decorations/green_leaves_decor.png"
                 class="decor-left"
                 alt="" />


            <img src="~/images/Decorations/green_leaves_decor.png"
                 class="decor-right"
                 alt="" />



            <div class="benefits-grid">


                <div class="benefit">

                    <div class="benefit-icon">
                        🌿
                    </div>


                    <div>

                        <h6>
                            Healthy Recipes
                        </h6>

                        <p>
