@using NutriWeek.Data.Models;
@model IEnumerable<Meal>


<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>All Meals</h1>

    <a href="#" class="btn btn-success">
        Add Meal
    </a>
    <a href="#" class="btn btn-success">
        Delete Meal
    </a>
</div>

@foreach (var meal in Model)
{
    <h3>@meal.Id</h3>
    <p>@meal.DailyMenu</p>


    <hr />
}