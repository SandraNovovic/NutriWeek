@if (dailyMenus.Any())
{

    <script>

        document.addEventListener(
            "DOMContentLoaded",
            function () {


                const dateSelect =
                    document.getElementById(
                        "dailyMenuDateSelect"
                    );


                const previousButton =
                    document.getElementById(
                        "previousDay"
                    );


                const nextButton =
                    document.getElementById(
                        "nextDay"
                    );


                const panels =
                    Array.from(
                        document.querySelectorAll(
                            ".day-panel"
                        )
                    );


                let currentIndex = 0;


                function showDay(
                    index
                ) {


                    if (
                        index < 0 ||
                        index >= panels.length
                    ) {

                        return;

                    }


                    currentIndex =
                        index;


                    panels.forEach(
                        function (
                            panel,
                            panelIndex
                        ) {


                            panel.classList.toggle(
                                "active",
                                panelIndex === currentIndex
                            );


                        }
                    );


                    dateSelect.value =
                        currentIndex;


                    previousButton.disabled =
                        currentIndex === 0;


                    nextButton.disabled =
                        currentIndex ===
                        panels.length - 1;


                }


                previousButton.addEventListener(
                    "click",
                    function () {


                        showDay(
                            currentIndex - 1
                        );


                    }
                );


                nextButton.addEventListener(
                    "click",
                    function () {


                        showDay(
                            currentIndex + 1
                        );


                    }
                );


                dateSelect.addEventListener(
                    "change",
                    function () {


                        showDay(
                            Number(
                                this.value
                            )
                        );


                    }
                );


                showDay(0);


            }
        );

    </script>

}
