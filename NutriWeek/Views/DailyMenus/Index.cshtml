@using NutriWeek.Data.Models;
@model IEnumerable<DailyMenu>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>All Daily Menus</h1>

    <a href="#" class="btn btn-success">
        Add Daily Menu
    </a>
    <a href="#" class="btn btn-success">
        Delete Daily Menu
    </a>
</div>

@foreach (var dailyMenu in Model)
{
    <h3>@dailyMenu.Id</h3>
    <p>@dailyMenu.Date</p>
    <p>@dailyMenu.Meals.ToList() </p>

    <hr />
}