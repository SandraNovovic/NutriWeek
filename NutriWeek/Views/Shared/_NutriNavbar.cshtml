@{
    string? currentController =
        ViewContext.RouteData.Values["controller"]?.ToString();

    DateTime today =
        DateTime.Today;

    int difference =
        ((int)today.DayOfWeek -
         (int)DayOfWeek.Monday + 7) % 7;

    DateTime currentWeekStart =
        today.AddDays(-difference).Date;

    string Active(string controller)
    {
        return string.Equals(
            currentController,
            controller,
            StringComparison.OrdinalIgnoreCase)
                ? "active"
                : string.Empty;
    }
}

<link rel="stylesheet"
      href="~/css/nutri-navbar.css"
      asp-append-version="true" />

<nav class="nutri-navbar">

    <div class="nav-content">

        <a asp-controller="Home"
           asp-action="Index"
           class="nav-brand">

            <span class="nav-brand-leaf">🌿</span>

            NutriWeek

        </a>


        <div class="nav-links">

            <a asp-controller="Home"
               asp-action="Index"
               class="nav-link-custom @Active("Home")">
                Home
            </a>

            <a asp-controller="Dishes"
               asp-action="Index"
               class="nav-link-custom @Active("Dishes")">
                Dishes
            </a>

            <a asp-controller="DailyMenus"
               asp-action="Index"
               asp-route-date="@today.ToString("yyyy-MM-dd")"
               class="nav-link-custom @Active("DailyMenus")">
                Daily Menu
            </a>

            <a asp-controller="WeeklyMenus"
               asp-action="Index"
               asp-route-weekStart="@currentWeekStart.ToString("yyyy-MM-dd")"
               class="nav-link-custom @Active("WeeklyMenus")">
                Weekly Menu
            </a>

            <a asp-controller="Meals"
               asp-action="Index"
               class="nav-link-custom @Active("Meals")">
                Meals
            </a>

        </div>


        <form asp-controller="Dishes"
              asp-action="Index"
              method="get"
              class="navbar-search">

            <button type="submit"
                    class="navbar-search-button"
                    aria-label="Search dishes">
                🔍
            </button>

            <input id="navbarDishSearch"
                   name="search"
                   type="search"
                   value="@Context.Request.Query["search"]"
                   placeholder="Search dishes..."
                   autocomplete="off" />

        </form>


        <div class="nav-account">

            @if (User.Identity?.IsAuthenticated == true)
            {
                <div class="user-pill">

                    <span class="user-pill-icon">
                        U
                    </span>

                    <span class="user-name">
                        @User.Identity.Name
                    </span>

                </div>

                <form asp-area="Identity"
                      asp-page="/Account/Logout"
                      asp-route-returnUrl="/Identity/Account/Login"
                      method="post"
                      class="logout-form">

                    <button type="submit"
                            class="logout-button">
                        Log out
                    </button>

                </form>
            }
            else
            {
                <a asp-area="Identity"
                   asp-page="/Account/Login"
                   class="auth-button login-button">
                    Log in
                </a>

                <a asp-area="Identity"
                   asp-page="/Account/Register"
                   class="auth-button register-button">
                    Register
                </a>
            }

        </div>

    </div>

</nav>
