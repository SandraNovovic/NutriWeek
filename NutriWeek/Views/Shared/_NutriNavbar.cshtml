@{
    string? currentController =
        ViewContext.RouteData.Values["controller"]?.ToString();

    DateTime today =
        DateTime.Today;

    int difference =
        ((int)today.DayOfWeek -
         (int)DayOfWeek.Monday + 7) % 7;

    DateTime currentWeekStart =
        today.AddDays(-difference).Date;

    string Active(string controller)
    {
        return string.Equals(
            currentController,
            controller,
            StringComparison.OrdinalIgnoreCase)
                ? "active"
                : string.Empty;
    }
}

<link rel="stylesheet"
      href="~/css/nutri-navbar.css"
      asp-append-version="true" />

<style>
    .nutri-navbar {
        position: sticky;
        top: 0;
        z-index: 1000;
        width: 100%;
        height: 74px;
        display: flex;
        align-items: center;
        background: rgba(255,255,255,.98);
        border-bottom: 1px solid #e9eee7;
        box-shadow: 0 2px 10px rgba(0,0,0,.025);
    }

    .nav-content {
        width: min(1420px, calc(100% - 50px));
        margin: 0 auto;
        display: flex;
        align-items: center;
        gap: 28px;
    }

    .nav-brand {
        display: flex;
        align-items: center;
        gap: 8px;
        flex-shrink: 0;
        color: #111b14;
        text-decoration: none;
        font-size: 24px;
        font-weight: 800;
    }

        .nav-brand:hover {
            color: #111b14;
        }

    .nav-brand-leaf {
        color: #2f7b35;
        font-size: 27px;
    }

    .nav-links {
        margin-left: 22px;
        margin-right: auto;
        display: flex;
        align-items: center;
        gap: 31px;
    }

    .nav-link-custom {
        position: relative;
        padding: 27px 1px 23px;
        color: #343c35;
        text-decoration: none;
        font-size: 14px;
        font-weight: 500;
    }

        .nav-link-custom:hover {
            color: #2f7b35;
        }

        .nav-link-custom.active {
            color: #2f7b35;
            font-weight: 700;
        }

            .nav-link-custom.active::after {
                content: "";
                position: absolute;
                left: 0;
                right: 0;
                bottom: 14px;
                height: 3px;
                border-radius: 8px;
                background: #2f7b35;
            }

    .navbar-search {
        width: 270px;
        padding: 9px 15px;
        display: flex;
        align-items: center;
        gap: 8px;
        border: 1px solid #dde4da;
        border-radius: 30px;
        background: #fbfcfa;
    }

        .navbar-search input {
            width: 100%;
            border: none;
            outline: none;
            background: transparent;
            font-size: 13px;
        }
</style>

<nav class="nutri-navbar">

    <div class="nav-content">

        <a asp-controller="Home"
           asp-action="Index"
           class="nav-brand">

            <span class="nav-brand-leaf">🌿</span>

            NutriWeek

        </a>


        <div class="nav-links">

            <a asp-controller="Home"
               asp-action="Index"
               class="nav-link-custom @Active("Home")">
                Home
            </a>

            <a asp-controller="Dishes"
               asp-action="Index"
               class="nav-link-custom @Active("Dishes")">
                Dishes
            </a>

            <a asp-controller="DailyMenus"
               asp-action="Index"
               asp-route-date="@today.ToString("yyyy-MM-dd")"
               class="nav-link-custom @Active("DailyMenus")">
                Daily Menu
            </a>

            <a asp-controller="WeeklyMenus"
               asp-action="Index"
               asp-route-weekStart="@currentWeekStart.ToString("yyyy-MM-dd")"
               class="nav-link-custom @Active("WeeklyMenus")">
                Weekly Menu
            </a>

            <a asp-controller="Meals"
               asp-action="Index"
               class="nav-link-custom @Active("Meals")">
                Meals
            </a>

        </div>


        <form asp-controller="Dishes"
              asp-action="Index"
              method="get"
              class="navbar-search">

            <button type="submit"
                    class="navbar-search-button"
                    aria-label="Search dishes">
                🔍
            </button>

            <input id="navbarDishSearch"
                   name="search"
                   type="search"
                   value="@Context.Request.Query["search"]"
                   placeholder="Search dishes..."
                   autocomplete="off" />

        </form>


        <div class="nav-account">

            @if (User.Identity?.IsAuthenticated == true)
            {
                <div class="user-pill">

                    <span class="user-pill-icon">
                        U
                    </span>

                    <span class="user-name">
                        @User.Identity.Name
                    </span>

                </div>

                <form asp-area="Identity"
                      asp-page="/Account/Logout"
                      asp-route-returnUrl="/Identity/Account/Login"
                      method="post"
                      class="logout-form">

                    <button type="submit"
                            class="logout-button">
                        Log out
                    </button>

                </form>
            }
            else
            {
                <a asp-area="Identity"
                   asp-page="/Account/Login"
                   class="auth-button login-button">
                    Log in
                </a>

                <a asp-area="Identity"
                   asp-page="/Account/Register"
                   class="auth-button register-button">
                    Register
                </a>
            }

        </div>

    </div>

</nav>
